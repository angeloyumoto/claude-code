//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  G2S Compass · Community Rebuild — STRATEGY BUILD for the Strategy Tester (same engine as the indicator)
//  Original Pine Script v6 implementation written from the public G2S Compass
//  description, white paper, field guide and trading checklist. No source code
//  from the invite-only script was used or seen.
//
//  Modules: session liquidity ledger · sweeps · displacement / sharp reversal ·
//  FVG / IFVG execution zones · HTF FVG map · SMT divergence · session Volume
//  Profile (DEV / OV / PD / PW) · checklist panel · graded trade plan
//  (Entry / SL / TP1-3) · macro countdown · one "NEW IDEA" alert.
//
//  Decision support only. It does not place trades or guarantee anything.
// ─────────────────────────────────────────────────────────────────────────────
strategy("G2S Compass · Rebuild (backtest)", shorttitle = "G2S-BT", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500, dynamic_requests = true, initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 3, process_orders_on_close = true, calc_on_every_tick = false)
// Drawings convert bar-index coordinates to timestamps through `time`; an old gap's edge set thousands of bars back
// needs that buffer (runtime error RE10143 otherwise). 5000 is the maximum; every edge is also clamped to that reach.
max_bars_back(time, 5000)
const int DRAW_REACH = 2000
// every historical x-coordinate goes through f_x: never further back than the chart's time buffer can resolve
f_x(int x) =>
    math.max(x, math.max(2, bar_index - DRAW_REACH))

const string TZ = "America/New_York"

// ───────────────────────────── ① View & layout ─────────────────────────────
const string G1 = "① Display"
const string GS = "⑨ Selectivity (Custom preset only)"
viewPreset   = input.string("Compass · Complete", "G2S View", options = ["Compass · Complete", "Focus · Live idea", "Playbook · Price Action", "Value · Volume Profile", "Minimal · Clean Chart"], group = G1, tooltip = "What the chart shows. A view can only hide modules; the checkboxes below still apply inside it.\nComplete: everything.\nPlaybook: no Volume Profile (histogram, VAH / POC / VAL, VP context) – price-action models only, so every idea grades B.\nValue: Volume Profile, session levels and PDH / PDL only – no FVGs, SMT, sweep marks, checklist or trade plan.\nMinimal: chart-TF FVGs, VP levels, plan and a 3-row checklist – no histogram, HTF map, SMT, session lines, labels or liquidity panel.")
clLayout     = input.string("Compact", "Checklist", options = ["Full", "Compact", "Minimal", "Mobile", "Off"], inline = "cl", group = G1)
clPosIn      = input.string("Auto", "at", options = ["Auto", "Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "cl", group = G1, tooltip = "Full: numbered 1–6 checklist + detail rows + TP list.\nCompact: the detail rows only (as in the original).\nMinimal: Entry Model · Status · Macro.\nMobile: 5 short rows, defaults to bottom-right and hides the liquidity panel.\nMinimal and Mobile also hide lower-timeframe gaps covered by a bigger gap (④ 'Auto').\nAuto location = top-right (bottom-right for Mobile).")
drawMode     = input.string("Present", "Mode", options = ["Present", "Historical"], inline = "md", group = G1)
presentBars  = input.int(500, "bars", minval = 100, maxval = 2000, inline = "md", group = G1, tooltip = "Present: only the last N bars carry drawings – older gaps, idea tags, sweep marks and SMT connectors are removed and no line or box starts further back. Historical keeps everything the budgets allow.")
showLiqPanel = input.bool(false, "Liquidity panel", inline = "lp", group = G1)
liqPosIn     = input.string("Bottom Right", "at", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], inline = "lp", group = G1, tooltip = "Which session highs / lows are still untaken (✓ = swept, ? = no completed session yet). Moves to the opposite corner if it would sit under the checklist. Hidden with the Mobile checklist and in the Value and Minimal views.")
panelSizeIn  = input.string("Small", "Text size · panels", options = ["Tiny", "Small", "Normal"], inline = "tx", group = G1)
chartTextIn  = input.string("Tiny", "chart labels", options = ["Tiny", "Small"], inline = "tx", group = G1, tooltip = "Panels: the checklist and liquidity tables. Chart labels: every tab in the right-edge label column, box texts and idea tags (the live plan's tab is one size larger).")
labelMergeAtr = input.float(0.3, "Merge labels within (ATR ×)", minval = 0.05, step = 0.05, group = G1, tooltip = "Every price label (session levels, PDH / PDL, VP levels, plan entry / SL / TP, equal highs / lows, CISD) lives in ONE right-edge column. Labels closer than this are merged into one tab – the most important one gives the tab its colour, the hover text lists every level with its price.")
bullCol      = input.color(#1e9e6a, "Bull", inline = "dc", group = G1)
bearCol      = input.color(#d9453b, "Bear", inline = "dc", group = G1)
levelCol     = input.color(#78909c, "Levels", inline = "dc", group = G1)
sesIndivCol  = input.bool(false, "colour sessions individually", group = G1, tooltip = "Off: every session high / low, PDH / PDL and VP reference level uses the one Levels colour, so direction colours are reserved for sweeps, zones, the plan and tags. On: the ② session colours apply.")

// ───────────────────────────── ② Sessions ─────────────────────────────
const string G2 = "② Sessions (New York time)"
sAsiaOn   = input.bool(true, "Asia", inline = "s1", group = G2)
sAsia     = input.session("2000-0000", "", inline = "s1", group = G2)
sAsiaCol  = input.color(#8e7cc3, "", inline = "s1", group = G2)
sLdnOn    = input.bool(true, "London", inline = "s2", group = G2)
sLdn      = input.session("0200-0500", "", inline = "s2", group = G2)
sLdnCol   = input.color(#3d85c6, "", inline = "s2", group = G2)
sAmOn     = input.bool(true, "NY AM", inline = "s3", group = G2)
sAm       = input.session("0930-1200", "", inline = "s3", group = G2)
sAmCol    = input.color(#6aa84f, "", inline = "s3", group = G2)
sLunchOn  = input.bool(false, "NY Lunch", inline = "s4", group = G2)
sLunch    = input.session("1200-1330", "", inline = "s4", group = G2)
sLunchCol = input.color(#bf9000, "", inline = "s4", group = G2)
sPmOn     = input.bool(true, "NY PM", inline = "s5", group = G2)
sPm       = input.session("1330-1600", "", inline = "s5", group = G2)
sPmCol    = input.color(#e69138, "", inline = "s5", group = G2)
sFullOn   = input.bool(false, "Full NY", inline = "s6", group = G2)
sFull     = input.session("0930-1600", "", inline = "s6", group = G2)
sFullCol  = input.color(#7c8ea3, "", inline = "s6", group = G2, tooltip = "Full NY (09:30–16:00) overlaps NY AM / Lunch / PM and adds two more lines. Untick it for a lighter chart; its high / low still count as liquidity.")
sPdOn     = input.bool(true, "PDH / PDL", inline = "s7", group = G2)
sPdCol    = input.color(#999999, "", inline = "s7", group = G2)
sesStyleIn = input.string("Solid", "Line style · sessions", options = ["Solid", "Dotted", "Dashed"], inline = "ls", group = G2)
pdStyleIn  = input.string("Dashed", "PDH / PDL", options = ["Solid", "Dotted", "Dashed"], inline = "ls", group = G2)
levelLookback = input.int(240, "Lines start at most (bars) back", minval = 20, inline = "lk", group = G2)
takenMode  = input.string("Keep faded", "Taken levels", options = ["Keep faded", "Remove"], inline = "lk", group = G2, tooltip = "A taken level stops at the bar that took it, faded (or is removed); its label goes either way – the Liq left row and the ✓ in the liquidity panel carry the status.")
showSesLabels = input.bool(true, "Session level labels", group = G2, tooltip = "High / Low tags 8 bars right of price. A completed session draws in full colour and can be swept; the session still forming draws lighter and is not sweepable until it closes. Taken levels fade. PDH / PDL come from the daily feed. All session times are New York.")

// ───────────────────────────── ③ Liquidity & reaction ─────────────────────────────
const string G3 = "③ Liquidity, sweeps & reaction"
useInternal  = input.bool(true, "Track internal pivots", inline = "ip", group = G3)
eqOn         = input.bool(true, "EQH / EQL", inline = "eq", group = G3)
eqTolAtr     = input.float(0.1, "tolerance (ATR ×)", minval = 0, step = 0.05, inline = "eq", group = G3)
eqTolTicks   = input.int(2, "or ticks", minval = 0, inline = "eq", group = G3, tooltip = "Two or more confirmed pivots on the same side within the larger tolerance, formed within 'max age' bars and not yet traded through, form an equal-highs / equal-lows cluster at their extreme. A wick through it with the body closing back is an external-grade sweep (EQH / EQL) that passes the quality floor; untaken clusters are targets and are drawn as dotted lines.")
eqMaxAge     = input.int(150, "max age (bars)", minval = 20, inline = "eq", group = G3)
pivLen       = input.int(5, "length", minval = 2, maxval = 30, inline = "ip", group = G3, tooltip = "Confirmed swing highs / lows (N bars each side, last 24 kept) count as internal liquidity next to the session levels. A sweep of a session level always outranks an internal one; internal sweeps show as the small faint circles.")
reactWindow  = input.int(30, "Reaction window after sweep (bars)", minval = 3, group = G3, tooltip = "A sweep is dropped if no displacement / sharp reversal in its direction follows within this many bars. A two-sided sweep ('Review') also clears after this.")
thesisWindow = input.int(120, "Trade idea window after reaction (bars)", minval = 10, group = G3, tooltip = "How long a confirmed sweep + reaction stays the working trade idea. It also ends as soon as price closes back through the sweep extreme.")
dispAtr      = input.float(1.0, "Displacement body ≥ ATR ×", minval = 0.2, step = 0.1, group = G3, tooltip = "Displacement candle: body at least this × ATR(14), body at least half the range, closing beyond the previous bar's high / low in the working direction.")
wickMult     = input.float(1.5, "Sharp reversal wick ≥ body ×", minval = 0.5, step = 0.1, group = G3, tooltip = "Sharp reversal candle: range at least 1.2 ATR, rejection wick at least this × the body, closing in the half of the bar that faces the working direction. A later displacement replaces a sharp reversal.")
legMinAtrIn   = input.float(2.0, "Displacement leg ≥ ATR ×", minval = 0, step = 0.25, group = GS, tooltip = "From the sweep extreme to the farthest print since (the leg the reversal has travelled). No FVG / IFVG entry counts until the leg is at least this × ATR(14): a one-candle pop that goes nowhere is not displacement. 0 = off.")
sweepMarkIn  = input.string("External only", "Mark sweeps", options = ["External only", "All", "Off"], inline = "mk", group = G3)
showReactTri = input.bool(false, "Reversal triangles", inline = "mk", group = G3, tooltip = "Sweeps: a circle at the swept extreme (bigger and darker for session levels; hover for the level name and price). Triangles: the confirming displacement / reversal candle. Both are hidden in the Value view.")

// ───────────────────────────── ④ Fair Value Gaps ─────────────────────────────
const string G4 = "④ Fair Value Gaps (chart timeframe)"
showFvg      = input.bool(true, "Show FVGs", inline = "fv", group = G4)
showCe       = input.bool(false, "50% line", inline = "fv", group = G4, tooltip = "Live gaps end 4 bars past price. A gap that price closes through becomes a purple IFVG when it belongs to the working trade idea, otherwise it is frozen where it died. The 50% (CE) line is optional.")
midClose     = input.bool(true, "Middle-close filter", group = G4, tooltip = "Keep a gap only when the middle candle closes beyond the first candle (a displacement gap). Also applies to the HTF map.")
minFvgPts    = input.float(0.0, "Min size · points", minval = 0, inline = "mn", group = G4)
minFvgAtr    = input.float(0.25, "ATR ×", minval = 0, step = 0.05, inline = "mn", group = G4, tooltip = "A gap must be at least the LARGER of the two. 0 points = ATR rule only.")
maxFvg       = input.int(40, "Max stored FVGs", minval = 5, maxval = 60, group = G4, tooltip = "Beyond this the oldest gaps (dead ones first) are dropped. Lower it for a quieter chart.")
fvgLblMode   = input.string("15m+ and IFVG only", "Box text", options = ["15m+ and IFVG only", "Timeframe only", "{tf} FVG", "None"], group = G4, tooltip = "Which boxes carry text. A respected gap always shows a ✓.")
gapShow      = input.string("Respected only", "Show gaps", options = ["Respected only", "Relevant to the idea", "All"], group = G4, tooltip = "Respected only (default): a gap is drawn only when price has already retested it and closed back off it without filling it (a ✓ is added to its label), when it is the live plan's entry zone, or when it is fresh (formed within 'Keep small-TF gaps visible for' bars, mapped 15m+ gaps: this session) and points the way of the current idea. Untested, filled and off-direction gaps are hidden.\nRelevant to the idea: everything formed inside the current idea plus respected and plan gaps.\nAll: every stored gap.")
ltfShowBars  = input.int(20, "Keep small-TF gaps visible for (bars)", minval = 5, group = G4, tooltip = "Chart-timeframe and 3m / 5m gaps are drawn only while they matter: formed inside the current trade idea, used by the live plan, inverted under the live sweep, or younger than this many bars. Everything else is hidden; a gap that served a past idea stays as a short block. 15m-and-higher gaps keep their long blocks (dimmed when price is far).")
fvgBullCol   = input.color(color.new(#26a69a, 90), "Bull", inline = "fc", group = G4)
fvgBearCol   = input.color(color.new(#ef5350, 90), "Bear", inline = "fc", group = G4)
ifvgCol      = input.color(color.new(#ba68c8, 90), "IFVG", inline = "fc", group = G4, tooltip = "Box fills. Mapped 15m-and-higher gaps draw a little lighter than these so stacked zones do not go dark.")
nearAtr      = input.float(1.0, "Show older gaps within (ATR ×)", minval = 0.1, step = 0.25, group = G4, tooltip = "Gaps from earlier sessions stay invisible until price comes this close (3× this for mapped HTF gaps). Lower = cleaner chart.")
promoteIn    = input.string("On", "Hide nested gaps", options = ["Auto", "On", "Off"], group = G4, tooltip = "On 1m / 3m / 5m charts a gap lying inside an active same-direction gap of the next slot (3m → 5m → 15m) is hidden so only the bigger zone shows. Auto = on for the Minimal / Mobile checklist and the Minimal view.")

// ───────────────────────────── ⑤ HTF FVG map ─────────────────────────────
const string G4B = "⑤ HTF FVG map"
htfOn1 = input.bool(true, "", inline = "h1", group = G4B)
htfTf1 = input.timeframe("3", "Slot 1", inline = "h1", group = G4B, tooltip = "Gaps from higher timeframes drawn on the chart, anchored at the candle that made them. A slot is skipped when it is not above the chart timeframe. Keep slots 1–3 at 3m / 5m / 15m for the ④ 'covered gap' ladder to work.")
htfOn2 = input.bool(true, "", inline = "h2", group = G4B)
htfTf2 = input.timeframe("5", "Slot 2", inline = "h2", group = G4B)
htfOn3 = input.bool(true, "", inline = "h3", group = G4B)
htfTf3 = input.timeframe("15", "Slot 3", inline = "h3", group = G4B)
htfOn4 = input.bool(true, "", inline = "h4", group = G4B)
htfTf4 = input.timeframe("60", "Slot 4", inline = "h4", group = G4B)
htfOn5 = input.bool(true, "", inline = "h5", group = G4B)
htfTf5 = input.timeframe("240", "Slot 5", inline = "h5", group = G4B)
htfOn6 = input.bool(false, "", inline = "h6", group = G4B)
htfTf6 = input.timeframe("D", "Slot 6", inline = "h6", group = G4B)
htfMinPts = input.float(10.0, "Min mapped gap size (points)", minval = 0, group = G4B, tooltip = "Price points, so instrument-specific: 10 suits NQ; use 0 on ES / FX and rely on the ATR rule. The chart-TF minimums in ④ also apply.")
maxHtf    = input.int(8, "Max stored gaps per slot", minval = 2, maxval = 20, inline = "mh", group = G4B)
htfShowLast = input.int(2, "fill the newest", minval = 0, maxval = 8, inline = "mh", group = G4B, tooltip = "Older active 15m+ gaps keep only their dashed frame until price comes within 'Show older gaps within' × 3; the newest N per slot are filled.")
htfPlace  = input.string("Price Action", "Placement on 1m / 3m / 5m charts", options = ["Price Action", "Right Side"], group = G4B, tooltip = "Price Action: boxes sit where the HTF candle made the gap.\nRight Side: 15m-and-higher gaps are parked to the right of price (the original's Right mode). No effect on 15m+ charts.")
htfOffset = input.int(3, "Right side · offset (bars)", minval = 0, maxval = 200, inline = "ho", group = G4B)
htfWidth  = input.int(12, "width (bars)", minval = 3, maxval = 300, inline = "ho", group = G4B)

// ───────────────────────────── ⑥ SMT ─────────────────────────────
const string G5 = "⑥ SMT divergence"
smtOn1   = input.bool(true, "", inline = "m1", group = G5)
smtSym1  = input.symbol("CME_MINI:ES1!", "Comparison 1", inline = "m1", group = G5, tooltip = "A correlated market (ES or YM for NQ; NQ for ES). SMT = the chart prints a higher high / lower low while the comparison does not. Change it when the chart IS this symbol, otherwise no divergence can ever be recorded.")
smtOn2   = input.bool(false, "", inline = "m2", group = G5)
smtSym2  = input.symbol("CBOT_MINI:YM1!", "Comparison 2", inline = "m2", group = G5)
smtPiv   = input.int(5, "Pivot length", minval = 2, maxval = 30, inline = "sp", group = G5)
smtValid = input.int(120, "valid for (bars)", minval = 10, inline = "sp", group = G5, tooltip = "Pivot length: swing size (bars each side) compared across the two markets, independent of the ③ pivot length. Valid for: how long a recorded SMT counts toward the checklist tick and the A+ grade.")
showSmt  = input.bool(true, "Draw SMT connectors", group = G5, tooltip = "A line between the two diverging swings with a 'Bullish SMT · ES' / 'Bearish SMT · ES' tag in the bull / bear colour. Detection and grading still run when this is off.")

// ───────────────────────────── ⑦ Volume Profile ─────────────────────────────
const string G6 = "⑦ Volume Profile"
vpOn       = input.bool(true, "Session Volume Profile", group = G6, tooltip = "DEV = the session profile still forming, OV = the last completed profile, PD = the same session yesterday, PW = previous week. Each gives VAH / POC / VAL; a close through one of them sets the VP context (Rotation when re-entering value or crossing the POC, Continuation when breaking out).")
vpSesAL    = input.session("1600-0929", "Overnight profile", group = G6)
vpSesNY    = input.session("0930-1600", "New York cash profile", group = G6)
vpPmRestart = input.bool(true, "Restart DEV for NY PM", inline = "pm", group = G6)
vpSesPM    = input.session("1330-1600", "", inline = "pm", group = G6, tooltip = "Starts a fresh developing profile at the PM open. As in the original, the overnight profile keeps serving as OV through the afternoon; the morning profile returns tomorrow as PD.")
vpDist     = input.string("Intrabar (auto)", "Volume distribution", options = ["Intrabar (auto)", "Bar range", "Close only"], inline = "vd", group = G6)
vaMethod   = input.string("Classic (two-row blocks)", "Value area", options = ["Classic (two-row blocks)", "Single rows"], inline = "vd", group = G6, tooltip = "How each bar's volume lands in the rows.\nIntrabar (auto): the bar is split into its lower-timeframe candles (1m on charts up to 15m, 5m on 1H, 15m on 4H, 1H on daily) and each one spreads its own volume over the rows it covers – the most accurate shape, and what the standard profile scripts do. On a 1m chart it falls back to the bar range. TradingView serves about 100,000 intrabars, so very old bars fall back too.\nBar range: the whole bar's volume spread evenly over its high–low range.\nClose only: all volume at the close.\nValue area: Classic grows from the POC by the larger of the two rows above vs the two rows below (the CBOT method used by the built-in Volume Profile); Single rows grows one row at a time. Different choices move VAH / POC / VAL by a few points, which is what you see when two profile scripts disagree.")
vpRows     = input.int(200, "Rows", minval = 10, maxval = 2000, step = 10, inline = "rv", group = G6)
vpVaPct    = input.float(70, "Value area %", minval = 50, maxval = 95, step = 1, inline = "rv", group = G6, tooltip = "Rows: how finely the expected session range is sliced (more = finer VAH / POC / VAL). 200 ≈ 1.25-point rows on NQ; the histogram is drawn in at most 80 rows anyway, and every row costs loop time on every bar. Value area: share of volume around the POC that defines VAH / VAL (70% is standard).")
showDev = input.bool(true, "Levels · DEV", inline = "vr", group = G6)
showOv  = input.bool(true, "OV", inline = "vr", group = G6)
showPd  = input.bool(true, "PD", inline = "vr", group = G6)
showPw  = input.bool(true, "PW", inline = "vr", group = G6, tooltip = "Which profiles' VAH / POC / VAL are drawn AND used for VP context, stacked-level confluence and targets. Line style: DEV solid · OV dashed · PD / PW dotted; reference profiles draw lighter.")
vpDrawIn   = input.string("DEV + OV", "Draw levels of", options = ["DEV only", "DEV + OV", "DEV + OV + PD", "All shown"], inline = "vd2", group = G6)
showFrozen = input.bool(false, "keep finished POC", inline = "vd2", group = G6, tooltip = "Which profiles' lines are drawn; every ticked profile is still used for context, confluence and targets. The developing POC is the one strong neutral line; VAH / VAL and reference levels use the Levels colour.")
pocCol  = input.color(#d9453b, "POC colour · reference profiles", group = G6)
vpLabels   = input.bool(true, "Level labels", inline = "vlb", group = G6)
vpPrices   = input.bool(false, "with prices", inline = "vlb", group = G6, tooltip = "A * after a DEV label means the developing profile is not yet eligible (see 'DEV eligible after').")
vpHistMode = input.string("Developing only", "Histogram", options = ["Off", "Developing only", "Developing + previous", "Developing + 3 previous"], group = G6, tooltip = "Finished profiles are drawn faded (Left: at the session start, Right: at its end). Width is capped at about 12% of the session's bars, so it stays narrow on higher timeframes.")
vpPlace    = input.string("Left", "Histogram side", options = ["Left", "Right"], inline = "hp", group = G6)
vpWidth    = input.int(20, "max width (bars)", minval = 5, maxval = 200, step = 5, inline = "hp", group = G6)
histOn1m   = input.bool(false, "Histogram on 1m charts", group = G6, tooltip = "The developing histogram is drawn on 3m and higher charts by default; on 1m it hides the price action.")
vpUpCol    = input.color(color.new(#4caf50, 78), "Up volume", inline = "vc", group = G6)
vpDnCol    = input.color(color.new(#2e7d32, 85), "Down volume", inline = "vc", group = G6)
holdBars   = input.int(3, "VP Hold · confirmed closes", minval = 1, maxval = 10, group = G6, tooltip = "Consecutive closes on the far side of a crossed level needed for a 'VP Hold' entry (Value Rotation). A 'VP Retest' fires earlier when price wicks back to the level and closes beyond it.")
holdMaxAtr = input.float(1.5, "VP Hold · max distance from level (ATR ×)", minval = 0.25, step = 0.25, group = G6, tooltip = "A 'VP Hold' entry only fires while the confirming close is within this distance of the crossed level, so a hold that has already run away from OV / PD value is not chased (its stop would be the ATR fallback anyway).")
vpWindow   = input.int(60, "VP context valid for (bars)", minval = 10, group = G6, tooltip = "A level cross is forgotten after this many bars, or as soon as price closes 1 ATR back through the level.")
devMinBars = input.int(20, "DEV eligible after (bars)", minval = 1, group = G6, tooltip = "The developing profile is too thin to trade until it has this many bars; until then its levels carry a * and OV is the reference for 'Inside / Above / Below value'.")

// ───────────────────────────── ⑧ Trade plan ─────────────────────────────
const string G7 = "⑧ Trade plan"
preset      = input.string("Strict · A setups only", "Selectivity preset", options = ["Strict · A setups only", "Original · every graded setup", "Custom · inputs below"], group = G7, tooltip = "Which gates decide what becomes a saved idea (and an alert).\nStrict: grade A or better, the two killzones, external sweep (VP-led ideas pass), 15m+ HTF bias, market structure shift, 2 ATR displacement leg, no full-fill retests, two ideas per session (A+ may add one), cooldown and quiet periods, IFVG Close pending at the zone.\nOriginal: what the invite-only script does – every complete model saves as B or better, any session, internal sweeps count, no bias / confluence / leg / structure-shift gates, no cap, IFVG Close enters at the close. Expect many more ideas and the lower win rate that comes with them.\nCustom: the individual inputs below. Stops, targets, breakeven and the drawings are the same in every preset.")
gradeMode   = input.string("Confluence score", "Grading", options = ["Confluence score", "G2S original (VP alignment)"], inline = "gm", group = G7)
scoreA      = input.int(3, "A at", minval = 1, maxval = 10, inline = "gm", group = G7)
scoreAp     = input.int(5, "A+ at", minval = 2, maxval = 10, inline = "gm", group = G7, tooltip = "Confluence score (default): every complete setup collects up to 10 points – external sweep, market structure shift, strong displacement leg (≥ 3 ATR), HTF FVG, SMT, VP alignment, killzone / Silver Bullet time, discount / premium entry (≥ 50 % retrace of the leg), Unicorn (entry zone overlapping the breaker block), value structure (stacked VP levels or an open outside value rotating back). A = at least 'A at' points, A+ = at least 'A+ at'. The header shows the live score and its hover text lists the points.\nG2S original: A = sweep + reaction AND VP alignment, A+ = A plus two confluences, as the invite-only script grades.")
entryGaps   = input.string("Chart + 3m / 5m map", "Entry zones from", options = ["Chart + 3m / 5m map", "Chart timeframe only"], group = G7, tooltip = "Which fair value gaps can be retested for an entry. Chart + 3m / 5m map (default): on a 1m chart the mapped 3m and 5m gaps formed since the sweep are entry zones too, so a clean 5m gap counts even when the 1m gap is messy. IFVGs always come from the chart timeframe.")
useBreaker  = input.bool(true, "Breaker block entries", inline = "bk", group = G7)
showBreaker = input.bool(true, "draw it", inline = "bk", group = G7, tooltip = "ICT breaker block: after the sweep and the structure shift, the last candle that closed in the old direction at the swing the shift broke (the failed order block) becomes a zone. A retest that closes back beyond it is the 'Breaker Retest' model; an FVG entry zone overlapping it is the 'Unicorn' confluence point. The zone ends when price closes through it.")
useOte      = input.bool(true, "OTE entries (62–79 % retrace of the displacement leg)", group = G7, tooltip = "Optimal Trade Entry: when price pulls back into the 62–79 % retracement of the leg from the sweep extreme to the farthest print since, and holds (closes inside or above the 79 % level), a plan is armed at the 70.5 % level with the sweep wick as the stop. One OTE idea per sweep. Catches the reversals that retrace deeper than the fair value gap.")
showPlan    = input.string("Position boxes", "Draw the plan", options = ["Position boxes", "Lines", "Off"], group = G7, tooltip = "Lines and labels for the saved idea, extended 17 bars past price while it is live; a completed plan is frozen for 'Show result for' bars. Detection, grading and the NEW IDEA alert run regardless.")
entryRefIn  = input.string("Near Edge", "FVG entry reference", options = ["Near Edge", "50%", "Far Edge", "Confirmation Close"], group = G7, tooltip = "Where a retest plan enters inside the FVG / IFVG. Near Edge = the edge price reaches first (original default). Confirmation Close = the current close, so the plan is live at once instead of pending.")
stopRefIn   = input.string("Structure (sweep wick → pivot → gap)", "Stop reference (FVG models)", options = ["Structure (sweep wick → pivot → gap)", "FVG far edge", "Trade Idea High/Low", "Latest High/Low", "Internal High/Low", "ATR Stop"], group = G7, tooltip = "Structural stop for FVG / IFVG models (VP models always use the hold / retest extreme or the level).\nStructure: the sweep wick while it is within 'Max stop', else the nearest protected pivot between the entry and that wick, else the far edge of the zone (checklist: below / above the rejection wick, 1–2 structure legs behind the entry, protected by internal liquidity).\nFVG far edge: opposite edge of the zone.\nTrade Idea High/Low: the sweep extreme.\nLatest High/Low: the displacement candle extreme (a deep retest tags it on a 1m chart).\nInternal High/Low: nearest protected pivot.\nATR Stop: ATR distance only.")
slBufTicks  = input.int(4, "Stop buffer (ticks)", minval = 0, inline = "sl", group = G7)
slBufAtr    = input.float(0.25, "or ATR ×", minval = 0, step = 0.05, inline = "sl", group = G7)
slBufLegPctIn = input.float(8, "or % of the leg", minval = 0, step = 1, inline = "sl", group = G7, tooltip = "The buffer beyond the structural stop is the LARGEST of ticks, ATR × (the 5-minute ATR on 1m charts) and this share of the displacement leg, so the stop scales with the move being traded. A few ticks is not enough on a 1m NQ chart: the second, slightly deeper sweep of the same low tags it.")
resweepModeIn = input.string("Extend", "Next pool under the wick", options = ["Extend", "Skip", "Off"], inline = "rs", group = GS)
resweepAtr  = input.float(0.75, "within (ATR ×)", minval = 0.1, step = 0.25, inline = "rs", group = GS, tooltip = "An untaken session / PDH / PDL level or pivot that sits just beyond the sweep wick is the next target of the same sweep. Extend: the stop reference moves beyond that level (buffer and Max stop still apply). Skip: the idea waits. ATR here is the 5-minute ATR on 1m charts.")
oneIdeaPerSweepIn = input.bool(true, "One saved idea per sweep", group = GS, tooltip = "A sweep yields at most one idea that activates or is stopped. A deeper print beyond the sweep wick re-bases the sweep (new displacement and shift required), so a second idea needs new evidence, not the same wick.")
atrFallback = input.bool(false, "ATR stop when no structure fits", inline = "af", group = G7)
slAtrMult   = input.float(1.0, "× ATR", minval = 0.2, step = 0.1, inline = "af", group = G7, tooltip = "Off (default): an idea whose structural stop is missing, tighter than 0.25 ATR or wider than 'Max stop' is skipped (Status shows why) instead of getting a stop that no structure protects. On: the ATR stop (× ATR 14) replaces it and TP1 must pay 'TP1 minimum when the stop is the ATR fallback'.")
maxSlAtr    = input.float(3.0, "Max stop (ATR ×)", minval = 0.5, step = 0.5, inline = "mx", group = G7)
maxTpAtr    = input.float(8.0, "max target (ATR ×)", minval = 1, step = 0.5, inline = "mx", group = G7, tooltip = "A structural stop farther than the first value falls back to the ATR stop; candidate targets farther than the second are ignored.")
minTp1R     = input.float(1.0, "TP1 minimum (R)", minval = 0.25, step = 0.25, inline = "tp", group = G7)
tpSepR      = input.float(0.25, "separation (R)", minval = 0.1, step = 0.05, inline = "tp", group = G7, tooltip = "Targets (max 3, nearest first) come from VP levels, untaken session highs / lows, pivots and opposing FVG edges. Every target must be at least 'TP1 minimum' R away, and targets closer than 'separation' R to one already chosen are skipped. No valid target = no plan.")
pendingBars = input.int(40, "Pending expires after (bars)", minval = 5, maxval = 1000, inline = "lf", group = G7)
planMaxBars = input.int(150, "active times out after", minval = 10, maxval = 2000, inline = "lf", group = G7, tooltip = "Pending: bars a retest plan waits for price to reach the entry. Active: bars an entered plan may run without reaching TP1 before it is marked expired.")
resultBars  = input.int(10, "Show result for (bars)", minval = 1, group = G7)
minGradeIn  = input.string("A", "Minimum grade to save", options = ["B", "A", "A+"], inline = "fl", group = GS)
qualityFloorIn = input.string("External sweep (VP-led ideas pass)", "Quality floor", options = ["Off", "External sweep or VP context", "External sweep (VP-led ideas pass)", "External sweep"], group = GS, tooltip = "Which context may become an idea. Off = any confirmed sweep, including the small internal pivots (③ length). External sweep or VP context = a session / PDH / PDL sweep, or any VP level cross in the idea's direction. External sweep (VP-led ideas pass) = price-action ideas need a live session / PDH / PDL sweep in their direction; VP Hold / VP Retest ideas pass on their own. External sweep = every idea needs the external sweep.")
htfBiasIn    = input.string("Value location (OV / PD)", "HTF bias filter", options = ["Off", "15m+ FVG map", "Value location (OV / PD)", "Daily bias", "Value + Daily", "Map + Value"], group = GS, tooltip = "Refuse ideas against the higher-timeframe picture. 15m+ FVG map: the newest active mapped gap of 15m or higher sets the bias (none active = neutral). Value location: above the last completed value area (OV, else PD) = bull only, below = bear only, inside = neutral. Both: an idea must not oppose either. Reversal ideas often oppose the last 15m gap, so this trades frequency for alignment.")
coolStopIn   = input.bool(true, "Cooldown · no re-entry on the same structure after a stop-out", group = GS, tooltip = "After a stop-out, no new idea in the same direction from the same sweep (same sweep bar) or the same VP level cross. A deeper / fresh sweep, a new level cross or an opposite-direction idea lifts it.")
openQuietMinIn = input.int(5, "No ideas in the first (min) of a session", minval = 0, inline = "qt", group = GS)
reviewQuietIn = input.int(15, "and (bars) after a two-sided sweep", minval = 0, inline = "qt", group = GS, tooltip = "Quiet periods: no plan is saved (and no NEW IDEA alert fires) this many minutes after a shown ② session opens, nor this many bars after a two-sided sweep, even when a one-sided sweep replaces the review at once. Sweeps, reactions and the panel keep updating; a retest after the quiet time still counts. 0 = off.")
zoneMaxAge  = input.int(40, "Zone retest within (bars)", inline = "za", minval = 5, group = GS)
minTradeGapAtr = input.float(0.5, "min gap to trade (ATR ×)", minval = 0, step = 0.05, inline = "za", group = GS, tooltip = "An IFVG must have inverted, and an FVG must have formed, within this many bars for its retest to count ('IFVG Close' is always fresh). FVG / IFVG entry models only use gaps at least this big; ④ still draws smaller ones (a thinner gap has no room for a structural stop). 0 = off.")
atrMinTp1R  = input.float(1.5, "TP1 minimum when the stop is the ATR fallback (R)", minval = 0.5, step = 0.25, group = G7, tooltip = "When no structural stop is usable (missing, tighter than 0.25 ATR or wider than 'Max stop') the ATR stop replaces it and TP1 must pay at least this many R; nearer targets are dropped. 1.0 = same as the normal minimum.")
needLiqTp   = input.bool(true, "Targets need a liquidity / VP level", group = G7, tooltip = "At least one target must be a VP level, an untaken session high / low, PDH / PDL or a pivot. A plan whose only draws are opposing FVG edges waits instead of saving.")
needMssIn    = input.bool(true, "Require a market structure shift", inline = "ms", group = GS)
mssModeIn   = input.string("Either", "Shift test", options = ["CISD", "10-bar high / low", "Either", "Both"], inline = "ms2", group = GS)
cisdMaxRun  = input.int(12, "CISD run · max candles", minval = 1, maxval = 30, inline = "ms2", group = GS, tooltip = "CISD: after a low sweep, the first candle whose BODY closes above the open of the run of down-closing candles that printed the low (mirror for highs) – ICT's change in state of delivery, usually earlier than the swing break. 10-bar: a close beyond the highest high / lowest low of the lookback before the sweep. Either = whichever prints first; Both = both required. A small CISD run (≤ 1.5 ATR tall) is also the breaker block.")
mssLook     = input.int(10, "lookback (bars)", minval = 2, maxval = 60, inline = "ms", group = GS, tooltip = "ICT confirmation: after the sweep, price must CLOSE beyond the short-term high (low sweep) or low (high sweep) that preceded it – the highest high / lowest low of this many bars before the sweep candle – before an FVG / IFVG entry counts. A deeper sweep resets the reference. Shown in the checklist as 'MSS ✓'.")
ifvgCloseModeIn = input.string("Pending at the IFVG (retest)", "IFVG Close entry", options = ["Pending at the IFVG (retest)", "At the inversion close (original)"], group = GS, tooltip = "Pending (default): the confirmed inversion arms a plan at the IFVG itself (FVG entry reference) and waits for price to come back, as the checklist's 'entry area'. At the close: enters at the inversion candle's close – the fastest and the worst price, and the one most often stopped on the retest.")
confirmBarsIn = input.int(2, "Confirmation closes", minval = 1, maxval = 2, inline = "cf", group = GS)
confirmDistAtr = input.float(0.1, "beyond the entry (ATR ×)", minval = 0, step = 0.05, inline = "cf", group = GS, tooltip = "Retest models arm a PENDING plan at the zone's near edge as soon as price is away from it, like a resting limit order. It activates when a bar has touched the entry and closes back beyond it by this many ATR (5-minute ATR on 1m charts); with 2 closes the next bar must not close back inside the zone. The recorded fill stays the entry reference.")
ceDowngradeIn = input.bool(true, "CE downgrade", inline = "cf", group = GS, tooltip = "If the retest wick trades through the zone's 50 % (consequent encroachment) before activation, the entry moves to the CE and the stop to the far edge + buffer; a close through the CE before activation expires the plan.")
trendLockIn = input.string("Block reversals", "Trend-day lock", options = ["Block reversals", "Score only", "Off"], group = GS, tooltip = "After the Initial Balance (09:30–10:30) the day is read from two votes: one IB side extended by at least its own range with the other side intact, and at least 90 % of closes since 10:00 on one side of the session VWAP. Both votes = trend day. Block reversals: Liquidity Inversion ideas against the trend are not saved (they are followed as shadows). The lock lifts once both IB sides are broken. Score only: the day-type point only.")
confirmFill = input.bool(true, "Pending entry needs a close back beyond the entry", group = GS, tooltip = "A pending plan activates only on a bar that touches the entry and closes back on the trade side of it (the checklist's 'candle close respecting the gap'). A close through the far edge of the zone before any activation expires the plan; a wick to the stop before activation expires it too (no fill was taken). Off: a touch fills, as a resting limit order would.")
beMode      = input.string("After TP1", "Breakeven", options = ["After TP1", "After 1R or TP1", "Off"], group = G7, tooltip = "Checklist risk rule: move the stop to the entry after TP1 (the first liquidity target) or after 1R. A later stop at entry after TP1 still counts as a win (TP1 reached); at entry before TP1 it is a scratch, not a stop-out.")
sesIdeaCapIn = input.int(1, "Ideas per session (0 = unlimited)", minval = 0, inline = "sc", group = GS)
apExtraIn    = input.bool(true, "A+ may add one", inline = "sc", group = GS, tooltip = "Checklist discipline: one setup per session unless another A+ appears. A session here is a Volume Profile session (AL / NY / PM restart); expired ideas count too, so the saved idea is the one you take.")
needOptIn    = input.bool(true, "Require an HTF FVG or SMT confluence", group = GS, tooltip = "Checklist steps 2 and 3 are optional 'confidence boosters'; with this on, an idea is only saved when at least one of them is present: the sweep or the entry touched a mapped 15m-or-higher FVG in the trade direction, or a fresh SMT divergence points the same way. The grade itself is unchanged (A = sweep + reaction + VP alignment); this is a gate on top of it.")
noFullFillIn = input.bool(true, "Retest must not fill the whole gap", group = GS, tooltip = "An FVG / IFVG retest counts only when the retest candle's wick stays inside the zone (does not trade through its far edge). A full fill that then closes back is a weaker imbalance and, on a 1m chart, usually the first leg of the deeper pullback that takes the stop.")
tradeWindowIn = input.string("Killzones", "during", options = ["Killzones", "Silver Bullet (10–11 · 14–15)", "Any", "NY AM + PM", "NY AM only"], inline = "fl", group = GS, tooltip = "B = one complete entry model. A = sweep + reaction AND VP alignment (same direction). A+ = A plus two confluences (HTF FVG, SMT, external sweep, stacked VP levels). Default A: only complete, aligned setups are saved and alerted. The Playbook view has no VP, so there the floor is B. Ideas outside the window are not saved and do not alert.")
kzAm        = input.session("0930-1100", "Killzones · AM", inline = "kz", group = GS)
kzPm        = input.session("1330-1500", "PM", inline = "kz", group = GS, tooltip = "The 'Killzones' trading window (New York time): ideas are saved and alerted only inside these two ranges. The 11:00–13:30 chop is skipped by default; widen the ranges here if you trade it.")
lateWin     = input.session("1500-1545", "Late · continuation only", inline = "kz2", group = GS)
mocQuietIn  = input.bool(true, "no ideas 15:45–16:00", inline = "kz2", group = GS, tooltip = "Between the PM killzone and 15:45 only Value Continuation and with-trend ideas are saved (reversal ideas are shadowed as 'late-session reversal'); no new idea in the closing imbalance prints after 15:45.")
lunchQuietIn = input.bool(true, "Ignore VP crosses 12:00–13:29", inline = "lq", group = GS)
replacePendingIn = input.bool(true, "A stronger setup replaces a pending plan", inline = "lq", group = GS, tooltip = "Lunch: a value-area cross during the thin midday is not recorded (it must be re-confirmed after 13:30). Replace: while a plan is pending (not filled), a candidate with a higher confluence score replaces it instead of being blocked for up to 'Pending expires after' bars.")
sbAm        = input.session("1000-1100", "Silver Bullet · AM", inline = "sb", group = GS)
sbPm        = input.session("1400-1500", "PM", inline = "sb", group = GS, tooltip = "ICT Silver Bullet hours (New York time). As a trading window only these hours save ideas; in every window being inside them (or the killzones) earns the 'Time' confluence point.")
showStats   = input.bool(true, "Stats row (ideas · win rate)", inline = "st", group = G7)
markIdeas   = input.bool(true, "Mark past ideas", inline = "st", group = G7, tooltip = "Stats: ideas saved since the chart loaded; win % = reached TP1 among decided ideas; TP3 % = fully completed. Marks: a tag beyond each past idea's stop with grade and outcome (✓ TP1, ✗ stopped, ○ expired); hover for entry / stop / targets.")
shadowMode  = input.string("Same grade or better", "Shadow ideas (filtered setups)", options = ["Same grade or better", "All grades", "Off"], group = G7, tooltip = "Setups the gates refuse are followed as SHADOW ideas: never saved, drawn or alerted, but their outcome is tagged on the chart (faint tag, hover shows why it was filtered) and counted on the 'Filtered' stats line. Same grade or better (default): only setups at or above 'Minimum grade' that were refused for another reason (session cap, confluence, HTF bias, window, cooldown, a live plan) – so with grade A the chart shows A setups only. All grades: B setups too. One shadow at a time; the same zone is not followed twice.")
markKeep    = input.int(12, "Keep idea tags", minval = 1, maxval = 60, group = G7, tooltip = "Tags: grade · L / S · ✓ TP1 reached / ✗ stopped / ○ expired or scratch. Saved ideas draw solid, shadow ideas faint. Up to 200 tags; older ones are removed after this many days.")

// Alerts: the NEW IDEA alert() fires whenever a plan is saved; it does not depend on any checkbox
// (the original removed that dependency so alerts cannot be silenced by a stale setting).

// ───────────────────────────── Derived settings ─────────────────────────────
isPlaybook = viewPreset == "Playbook · Price Action"
isValue    = viewPreset == "Value · Volume Profile"
isMinimalV = viewPreset == "Minimal · Clean Chart"
isMobile   = clLayout == "Mobile"
isMinLay   = clLayout == "Minimal" or isMinimalV
isFocus    = viewPreset == "Focus · Live idea" or isMobile
isLean     = isMinLay or isMobile or isFocus
isPresent  = drawMode == "Present"
chartSec   = timeframe.in_seconds(timeframe.period)

// Selectivity preset → effective gate values (the engine reads these, never the raw inputs)
isStrict = preset == "Strict · A setups only"
isOrig   = preset == "Original · every graded setup"
minGrade      = isStrict ? "A" : isOrig ? "B" : minGradeIn
tradeWindow   = isStrict ? "Killzones" : isOrig ? "Any" : tradeWindowIn
needOpt       = isStrict ? false : isOrig ? false : needOptIn
legMinAtr     = isStrict ? 2.0 : isOrig ? 0.0 : legMinAtrIn
noFullFill    = isStrict ? true : isOrig ? false : noFullFillIn
needMss       = isStrict ? true : isOrig ? false : needMssIn
sesIdeaCap    = isStrict ? 1 : isOrig ? 0 : sesIdeaCapIn
apExtra       = isStrict ? true : isOrig ? true : apExtraIn
qualityFloor  = isStrict ? "External sweep (VP-led ideas pass)" : isOrig ? "Off" : qualityFloorIn
htfBias       = isStrict ? "Value location (OV / PD)" : isOrig ? "Off" : htfBiasIn
resweepMode   = isStrict ? "Extend" : isOrig ? "Off" : resweepModeIn
slBufLegPct   = isStrict ? 8.0 : isOrig ? 0.0 : slBufLegPctIn
oneIdeaPerSweep = isStrict ? true : isOrig ? false : oneIdeaPerSweepIn
mocQuiet      = isStrict ? true : isOrig ? false : mocQuietIn
lunchQuiet    = isStrict ? true : isOrig ? false : lunchQuietIn
replacePending = isStrict ? true : isOrig ? false : replacePendingIn
mssMode       = isStrict ? "Either" : isOrig ? "10-bar high / low" : mssModeIn
confirmBars   = isStrict ? 2 : isOrig ? 1 : confirmBarsIn
ceDowngrade   = isStrict ? true : isOrig ? false : ceDowngradeIn
trendLock     = isStrict ? "Block reversals" : isOrig ? "Off" : trendLockIn
coolStop      = isStrict ? true : isOrig ? false : coolStopIn
openQuietMin  = isStrict ? 5 : isOrig ? 0 : openQuietMinIn
reviewQuiet   = isStrict ? 15 : isOrig ? 0 : reviewQuietIn
ifvgCloseMode = isStrict ? "Pending at the IFVG (retest)" : isOrig ? "At the inversion close (original)" : ifvgCloseModeIn

useVp        = vpOn and not isPlaybook
useHist      = useVp and vpHistMode != "Off" and not isMinimalV and (chartSec > 60 or histOn1m)
useFvg       = showFvg and not isValue
useHtf       = useFvg and not isMinimalV
useSmt       = showSmt and not isValue and not isMinimalV
useChecklist = clLayout != "Off" and not isValue
usePlanDraw  = showPlan != "Off" and not isValue
useLiqPanel  = showLiqPanel and not isValue and not isMobile and not isMinimalV
useSesLines  = not isMinimalV
useSweepMk   = sweepMarkIn != "Off" and not isValue
useReactTri  = showReactTri and not isValue
useIdeaMk    = markIdeas and not isValue and not isLean
useSesLabels = showSesLabels and not isLean
useVpLabels  = vpLabels and not isLean

panelSize = panelSizeIn == "Tiny" ? size.tiny : panelSizeIn == "Normal" ? size.normal : size.small
lblSz     = chartTextIn == "Small" ? size.small : size.tiny
lblSzUp   = chartTextIn == "Small" ? size.normal : size.small
fvgTxtSz  = lblSz
markSize  = lblSz
// alpha ladder: live 10 · untaken 45 · developing 65 · taken / bookkeeping 80
f_alpha(string s) =>
    s == "live" ? 10 : s == "untaken" ? 45 : s == "developing" ? 65 : 80
const int labelX = 6

f_pos(string s) =>
    s == "Top Left" ? position.top_left : s == "Bottom Right" ? position.bottom_right : s == "Bottom Left" ? position.bottom_left : position.top_right

f_opposite(string s) =>
    s == "Bottom Right" ? "Bottom Left" : s == "Bottom Left" ? "Bottom Right" : s == "Top Right" ? "Top Left" : "Top Right"

clPosName = clPosIn == "Auto" ? (isMobile ? "Bottom Right" : "Top Right") : clPosIn
clPos  = f_pos(clPosName)
liqPos = useChecklist and liqPosIn == clPosName ? f_pos(f_opposite(liqPosIn)) : f_pos(liqPosIn)
promote = promoteIn == "On" or (promoteIn == "Auto" and (isMobile or isMinLay))

f_style(string s) =>
    s == "Dotted" ? line.style_dotted : s == "Dashed" ? line.style_dashed : line.style_solid

sesStyle = f_style(sesStyleIn)
pdStyle  = f_style(pdStyleIn)


// ───────────────────────────── Core series ─────────────────────────────
atr      = ta.atr(14)
lo6      = ta.lowest(low, 6)
hi6      = ta.highest(high, 6)
tick     = syminfo.mintick
atr5     = request.security(syminfo.tickerid, "5", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
atrRisk  = chartSec < 300 ? nz(atr5, atr * 2) : atr     // stop floors and buffers on a 5-minute ATR, so 1m and 5m charts carry the same risk
isLtf    = chartSec < 15 * 60
bodySz   = math.abs(close - open)
rangeSz  = high - low
confirmed = barstate.isconfirmed

f_tfLabel(string tf) =>
    sec = timeframe.in_seconds(tf)
    sec < 60 ? str.tostring(sec) + "s" : sec < 3600 ? str.tostring(math.round(sec / 60.0)) + "m" : sec < 86400 ? str.tostring(math.round(sec / 3600.0)) + "H" : sec < 604800 ? "D" : sec < 2592000 ? "W" : "M"

chartTfLabel = f_tfLabel(timeframe.period)

f_inSess(string s) =>
    not na(time(timeframe.period, s, TZ))

f_price(float p) =>
    str.tostring(p, format.mintick)

f_mmss(int secs) =>
    s = math.max(secs, 0)
    m = math.floor(s / 60.0)
    r = s % 60
    (m < 10 ? "0" : "") + str.tostring(m) + ":" + (r < 10 ? "0" : "") + str.tostring(r)

// Previous-day high / low from the daily feed (non-repainting: closed bar + lookahead_on).
[pdHigh, pdLow, pdTime, pdClose, ppdHigh, ppdLow] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1], close[1], high[2], low[2]], lookahead = barmerge.lookahead_on)
dayBias = pdClose > ppdHigh ? 1 : pdClose < ppdLow ? -1 : 0   // yesterday closed outside the prior day's range → bias for today
// Intrabar candles for the Volume Profile (one lower timeframe per chart timeframe; never equal to or above the chart's).
ltfStr = chartSec <= 900 ? "1" : chartSec <= 3600 ? "5" : chartSec <= 14400 ? "15" : "60"
ltfOK  = vpDist == "Intrabar (auto)" and timeframe.in_seconds(ltfStr) < chartSec
[ibH, ibL, ibV, ibUp] = request.security_lower_tf(syminfo.tickerid, ltfStr, [high, low, volume, close >= open], ignore_invalid_timeframe = true)
pdRange = nz(pdHigh - pdLow, atr * 20)

// HTF candles for the FVG map: last three *completed* bars of each slot timeframe.
f_htfReq(string tf, bool enabled) =>
    float h1 = na
    float l1 = na
    float c1 = na
    float h2 = na
    float l2 = na
    float c2 = na
    float h3 = na
    float l3 = na
    int   t1 = na
    if enabled and useHtf and timeframe.in_seconds(tf) > chartSec
        [a, b, c, d, e, f, g, h, t] = request.security(syminfo.tickerid, tf, [high[1], low[1], close[1], high[2], low[2], close[2], high[3], low[3], time[1]], lookahead = barmerge.lookahead_on)
        h1 := a
        l1 := b
        c1 := c
        h2 := d
        l2 := e
        c2 := f
        h3 := g
        l3 := h
        t1 := t
    [h1, l1, c1, h2, l2, c2, h3, l3, t1]

[h1a, l1a, c1a, h2a, l2a, c2a, h3a, l3a, t1a] = f_htfReq(htfTf1, htfOn1)
[h1b, l1b, c1b, h2b, l2b, c2b, h3b, l3b, t1b] = f_htfReq(htfTf2, htfOn2)
[h1c, l1c, c1c, h2c, l2c, c2c, h3c, l3c, t1c] = f_htfReq(htfTf3, htfOn3)
[h1d, l1d, c1d, h2d, l2d, c2d, h3d, l3d, t1d] = f_htfReq(htfTf4, htfOn4)
[h1e, l1e, c1e, h2e, l2e, c2e, h3e, l3e, t1e] = f_htfReq(htfTf5, htfOn5)
[h1f, l1f, c1f, h2f, l2f, c2f, h3f, l3f, t1f] = f_htfReq(htfTf6, htfOn6)

// SMT comparison feeds (same timeframe as the chart). `time` lets us reject forward-filled bars.
f_smtReq(string sym, bool on) =>
    float h = na
    float l = na
    int   t = na
    if on
        [a, b, c] = request.security(sym, timeframe.period, [high, low, time], ignore_invalid_symbol = true)
        h := a
        l := b
        t := c
    [h, l, t]

[cmpH1, cmpL1, cmpT1] = f_smtReq(smtSym1, smtOn1)
[cmpH2, cmpL2, cmpT2] = f_smtReq(smtSym2, smtOn2)

// Comparison swing over the same ±smtPiv window that confirms a primary pivot.
smtWin = 2 * smtPiv + 1
cmpHi1 = ta.highest(cmpH1, smtWin)
cmpLo1 = ta.lowest(cmpL1, smtWin)
cmpHi2 = ta.highest(cmpH2, smtWin)
cmpLo2 = ta.lowest(cmpL2, smtWin)

// Single right-edge label column: every price label is pushed here during the last-bar draw and flushed once,
// sorted by price and merged within labelMergeAtr × ATR. Priority 1 = the plan (wins the tab's colour, bigger text).
var array<float>  edgeP = array.new<float>()
var array<string> edgeT = array.new<string>()
var array<color>  edgeC = array.new<color>()
var array<int>    edgePr = array.new<int>()
var array<label>  edgeL = array.new<label>()
f_edgePush(float p, string t, color c, int pr) =>
    if not na(p)
        array.push(edgeP, p)
        array.push(edgeT, t)
        array.push(edgeC, c)
        array.push(edgePr, pr)

f_edgeFlush() =>
    for l in edgeL
        label.delete(l)
    array.clear(edgeL)
    n = array.size(edgeP)
    if n > 0
        idx = array.sort_indices(edgeP, order.ascending)
        i = 0
        while i < n
            j = i
            bestK = array.get(idx, i)
            txt = ""
            tip = ""
            cnt = 0
            while j < n and (j == i or array.get(edgeP, array.get(idx, j)) - array.get(edgeP, array.get(idx, i)) <= labelMergeAtr * nz(atr))
                k = array.get(idx, j)
                bestK := array.get(edgePr, k) < array.get(edgePr, bestK) ? k : bestK
                txt := cnt < 3 ? (txt == "" ? array.get(edgeT, k) : txt + " · " + array.get(edgeT, k)) : cnt == 3 ? txt + " +" : txt
                tip := tip + array.get(edgeT, k) + "  " + f_price(array.get(edgeP, k)) + "\n"
                cnt += 1
                j += 1
            array.push(edgeL, label.new(bar_index + labelX, array.get(edgeP, bestK), txt, style = label.style_label_left, color = color.new(color.white, 100), textcolor = array.get(edgeC, bestK), size = array.get(edgePr, bestK) == 1 ? lblSzUp : lblSz, tooltip = tip))
            i := j
    array.clear(edgeP)
    array.clear(edgeT)
    array.clear(edgeC)
    array.clear(edgePr)

// ───────────────────────────── Types ─────────────────────────────
type Ses
    string name
    string abbr
    string sess
    color  col
    bool   show
    bool   isPd
    bool   active
    bool   done
    float  hi
    float  lo
    int    hiBar
    int    loBar
    int    hiTime
    int    loTime
    bool   hiTaken
    bool   loTaken
    int    hiTakenTime
    int    loTakenTime
    line   hiLn
    line   loLn
    label  hiLb
    label  loLb
    float  dHi           // developing instance (drawn live, never sweepable)
    float  dLo
    int    dHiBar
    int    dLoBar
    int    dHiTime
    int    dLoTime
    line   dHiLn
    line   dLoLn
    label  dHiLb
    label  dLoLb
    bool   hiClosed      // the level was closed through (body), not just wicked
    bool   loClosed

type Fvg
    box    bx
    line   ce
    float  top
    float  bottom
    int    dir
    int    barIdx
    int    state      // 0 active · 1 inverted (IFVG) · 2 dead
    int    invBar
    string tf
    bool   rightSide
    bool   used
    int    ses          // VP session counter when the gap formed (older-session gaps are dimmed until price returns)
    bool   traded       // a plan was saved from this gap (kept visible as a short block for review)
    int    resp         // respected retests: touched the near edge, closed back off it, no full fill
    int    lastTouch
    bool   inKz         // formed inside a killzone / Silver Bullet window (evidence for the time point)
    bool   inSb
    float  minClose     // lowest / highest close since the gap formed (a mapped gap can be closed through between its own bars)
    float  maxClose

type Profile
    string kind
    int    startBar
    int    endBar
    float  rowSize
    int    base
    array<float> vol
    array<float> upv
    float  poc
    float  vah
    float  val
    float  total
    float  hi
    float  lo
    bool   done
    array<box> boxes
    int    pocIdx       // row holding the most volume, maintained by f_acc so f_levels never rescans
    float  pocVol
    int    bars         // chart bars accumulated (eligibility and the caption)

type Piv
    float price
    int   bar
    bool  isHigh
    bool  eq          // member of an equal-highs / equal-lows cluster
    float eqLvl       // the cluster's extreme
    int   eqN

type State
    int    swDir
    string swName
    float  swLevel
    float  swExt
    int    swBar
    bool   swExternal
    bool   reactOK
    string reactType
    int    reactBar
    float  reactExt
    int    reactDir
    int    smtDir
    int    smtBar
    string smtWho
    int    vpDir
    string vpRole
    string vpLevel
    string vpKind
    int    vpBar
    int    holdCount
    float  holdExt
    string vpModel
    int    vpModelBar
    float  vpModelExt
    int    plState      // 0 none · 1 pending · 2 active · 3 complete · 4 invalid · 5 expired
    int    plDir
    float  plEntry
    float  plSl
    array<float> plTps
    int    plHit
    int    plBar
    int    plEndBar
    string plGrade
    string plModel
    string plFamily
    string plLed
    string plVpBasis
    string lastResult
    string lastNote
    int    lastNoteBar
    Fvg    plFvg
    line   lnEntry
    line   lnSl
    array<line>  lnTps
    label  lbEntry
    label  lbSl
    array<label> lbTps
    box    bxRisk
    box    bxReward
    box    bxZone
    string lastModel
    string lastModelLed
    int    lastModelBar
    int    nPlans
    int    nWin
    int    nLoss
    int    nFull
    int    nExp
    int    coolDir
    int    coolSwBar
    int    coolVpBar
    float  swOpp        // short-term high / low before the sweep; a close beyond it is the market structure shift
    bool   mssOK
    bool   plBe         // stop moved to breakeven
    float  plR          // risk at save (entry → original stop)
    int    ideaSes
    int    ideaCount
    float  legExt       // farthest print since the sweep (the displacement leg)
    string swHtf        // mapped 15m+ gap touched since the sweep (checklist step 2)
    int    swOppBar     // bar of the short-term high / low the shift must break
    float  brkTop       // breaker block (failed order block at that swing)
    float  brkBot
    int    brkBar
    bool   brkOK
    bool   brkUsed
    bool   oteUsed
    int    vpOpenOut    // session opened above (1) / below (-1) the previous value area (80 % rule context)
    int    plScore
    string plPts
    bool   swUsed       // one saved idea per sweep
    int    mssBar
    bool   mssInWin     // the shift printed inside a killzone / Silver Bullet window
    int    legExtBar
    int    rebaseBar    // bar of the last deeper print that re-based the sweep
    bool   resweepSkip
    float  cisdLvl      // open of the run of candles that closed into the sweep (change in state of delivery level)
    int    cisdBar
    float  cisdRunHi
    float  cisdRunLo
    string mssVia
    int    trendDir     // day-type lock: 1 trend up · -1 trend down · 0 balance / unknown
    float  plFar        // pending-plan zone geometry for the lifecycle step
    float  plZTop
    float  plZBot
    float  plBuf
    bool   plTouched
    int    plConfirmN
    bool   plCeHit
    float  plLegExt
    int    nCtrl        // placebo control: same bar, direction and distances, no zone
    int    nCtrlWin
    int    nCtrlLoss

// A refused setup followed to its outcome (never saved, drawn or alerted) so past ideas stay visible and countable.
// A pending / active lifecycle: the live plan (mirrored from st.pl*), a shadow idea, or the placebo control.
type Life
    int    state        // 0 none · 1 pending · 2 active
    int    dir
    float  entry
    float  sl
    array<float> tps
    int    hit
    int    bar
    string grade
    string model
    string family
    string led
    float  R
    bool   be
    Fvg    fvg
    string why
    int    lastFvgBar   // zone / level of the last shadow, so a re-hit does not start another
    string lastFvgTf
    int    lastVpBar
    int    lastBrkBar
    int    lastOteBar
    int    nPlans
    int    nWin
    int    nLoss
    int    nFull
    int    nExp
    bool   touched      // sticky: the entry was touched since arming
    int    confirmN     // consecutive confirming closes
    float  zTop         // entry zone (na = none)
    float  zBot
    float  far          // far edge of the zone (zone failure / CE downgrade stop)
    float  buf
    bool   ceHit

// ───────────────────────────── Session liquidity ledger ─────────────────────────────
f_newSes(string name, string abbr, string sess, color col, bool show, bool isPd) =>
    Ses.new(name = name, abbr = abbr, sess = sess, col = col, show = show, isPd = isPd, active = false, done = false, hiTaken = false, loTaken = false, hiClosed = false, loClosed = false)

var array<Ses> sessions = array.from(
  f_newSes("Asia", "ASIA", sAsia, sAsiaCol, sAsiaOn, false),
  f_newSes("London", "LDN", sLdn, sLdnCol, sLdnOn, false),
  f_newSes("NY AM", "NYAM", sAm, sAmCol, sAmOn, false),
  f_newSes("NY PM", "NYPM", sPm, sPmCol, sPmOn, false),
  f_newSes("Full NY", "NY", sFull, sFullCol, sFullOn, false),
  f_newSes("NY Lunch", "LUNCH", sLunch, sLunchCol, sLunchOn, false),
  f_newSes("Previous Day", "PD", "", sPdCol, sPdOn, true))

inSesArr = array.from(f_inSess(sAsia), f_inSess(sLdn), f_inSess(sAm), f_inSess(sPm), f_inSess(sFull), f_inSess(sLunch), false)
inKzAm = f_inSess(kzAm)
inKzPm = f_inSess(kzPm)
inSbAm = f_inSess(sbAm)
inSbPm = f_inSess(sbPm)
inLate = f_inSess(lateWin)
inMoc  = f_inSess("1545-1600")
inRth  = f_inSess("0930-1600")
inIb   = f_inSess("0930-1030")
rthStart = inRth and not inRth[1]
vw = ta.vwap(hlc3, rthStart)
// Day type: Initial Balance extension and VWAP side since 10:00
var float ibHi = na
var float ibLo = na
var float rthHi = na
var float rthLo = na
var int vwUpN = 0
var int vwDnN = 0
if confirmed and rthStart
    ibHi := high
    ibLo := low
    rthHi := high
    rthLo := low
    vwUpN := 0
    vwDnN := 0
if confirmed and inRth
    rthHi := math.max(nz(rthHi, high), high)
    rthLo := math.min(nz(rthLo, low), low)
    if inIb
        ibHi := math.max(nz(ibHi, high), high)
        ibLo := math.min(nz(ibLo, low), low)
    else
        vwUpN += close > vw ? 1 : 0
        vwDnN += close < vw ? 1 : 0
ibDone = inRth and not inIb and not na(ibHi)
ibR    = ibDone ? ibHi - ibLo : float(na)
extUp  = na(ibR) or ibR <= 0 ? 0.0 : math.max(0.0, rthHi - ibHi) / ibR
extDn  = na(ibR) or ibR <= 0 ? 0.0 : math.max(0.0, ibLo - rthLo) / ibR
vwPct  = vwUpN + vwDnN > 0 ? math.max(vwUpN, vwDnN) / float(vwUpN + vwDnN) : 0.0
vwSide = vwUpN > vwDnN ? 1 : vwUpN < vwDnN ? -1 : 0
ibBoth = extUp > 0 and extDn > 0
voteUp = extUp >= 1.0 and extDn == 0 and vwPct >= 0.9 and vwSide == 1 and vwUpN + vwDnN >= 10
voteDn = extDn >= 1.0 and extUp == 0 and vwPct >= 0.9 and vwSide == -1 and vwUpN + vwDnN >= 10
lunchNow = f_inSess("1200-1329")
var int kzSeq = 0
if confirmed and ((inKzAm and not inKzAm[1]) or (inKzPm and not inKzPm[1]))
    kzSeq += 1

f_sesDraw(Ses s) =>
    line.delete(s.hiLn)
    line.delete(s.loLn)
    label.delete(s.hiLb)
    label.delete(s.loLb)
    if useSesLines and s.show
        lst = s.isPd ? pdStyle : sesStyle
        c = sesIndivCol ? s.col : levelCol
        s.hiLn := line.new(f_x(math.max(s.hiBar, bar_index - levelLookback)), s.hi, bar_index + 5, s.hi, color = color.new(c, f_alpha("untaken")), style = lst)
        s.loLn := line.new(f_x(math.max(s.loBar, bar_index - levelLookback)), s.lo, bar_index + 5, s.lo, color = color.new(c, f_alpha("untaken")), style = lst)

// Developing instance: drawn lighter, never sweepable until it completes.
f_sesDrawDev(Ses s) =>
    line.delete(s.dHiLn)
    line.delete(s.dLoLn)
    label.delete(s.dHiLb)
    label.delete(s.dLoLb)
    if useSesLines and s.show and s.abbr != "NY"
        c = sesIndivCol ? s.col : levelCol
        s.dHiLn := line.new(f_x(math.max(s.dHiBar, bar_index - levelLookback)), s.dHi, bar_index + 5, s.dHi, color = color.new(c, f_alpha("developing")), style = sesStyle)
        s.dLoLn := line.new(f_x(math.max(s.dLoBar, bar_index - levelLookback)), s.dLo, bar_index + 5, s.dLo, color = color.new(c, f_alpha("developing")), style = sesStyle)

// A completed instance (or a new previous day) replaces the ledger record "by source name".
f_sesCommit(Ses s, float hi, float lo, int hiBar, int loBar, int hiTime, int loTime) =>
    s.done := true
    s.hi := hi
    s.lo := lo
    s.hiBar := hiBar
    s.loBar := loBar
    s.hiTime := hiTime
    s.loTime := loTime
    s.hiTaken := false
    s.loTaken := false
    s.hiClosed := false
    s.loClosed := false
    s.hiTakenTime := na
    s.loTakenTime := na
    f_sesDraw(s)

// Returns [highSweep, lowSweep] for this bar (ledger levels only: completed, previously untaken).
f_sesUpdate(Ses s, bool inNow, bool isNewDay) =>
    hiSw = false
    loSw = false
    if s.isPd
        if isNewDay and not na(pdHigh)
            f_sesCommit(s, pdHigh, pdLow, bar_index, bar_index, time, time)
    else if inNow and not s.active
        s.active := true
        s.dHi := high
        s.dLo := low
        s.dHiBar := bar_index
        s.dLoBar := bar_index
        s.dHiTime := time
        s.dLoTime := time
        f_sesDrawDev(s)
    else if inNow
        if high > s.dHi
            s.dHi := high
            s.dHiBar := bar_index
            s.dHiTime := time
            if not na(s.dHiLn)
                line.set_xy1(s.dHiLn, bar_index, high)
                line.set_xy2(s.dHiLn, bar_index + 8, high)
            if not na(s.dHiLb)
                label.set_y(s.dHiLb, high)
        if low < s.dLo
            s.dLo := low
            s.dLoBar := bar_index
            s.dLoTime := time
            if not na(s.dLoLn)
                line.set_xy1(s.dLoLn, bar_index, low)
                line.set_xy2(s.dLoLn, bar_index + 8, low)
            if not na(s.dLoLb)
                label.set_y(s.dLoLb, low)
    else if s.active
        s.active := false
        line.delete(s.dHiLn)
        line.delete(s.dLoLn)
        label.delete(s.dHiLb)
        label.delete(s.dLoLb)
        f_sesCommit(s, s.dHi, s.dLo, s.dHiBar, s.dLoBar, s.dHiTime, s.dLoTime)
    if s.done and not na(s.hi)
        if not s.hiTaken and high > s.hi
            hiSw := math.max(open, close) < s.hi
            s.hiTaken := true
            s.hiTakenTime := time
            s.hiClosed := close > s.hi
            if not na(s.hiLn)
                line.set_x2(s.hiLn, bar_index)
                line.set_color(s.hiLn, color.new(sesIndivCol ? s.col : levelCol, f_alpha("taken")))
                if takenMode == "Remove"
                    line.delete(s.hiLn)
        if not s.loTaken and low < s.lo
            loSw := math.min(open, close) > s.lo
            s.loTaken := true
            s.loTakenTime := time
            s.loClosed := close < s.lo
            if not na(s.loLn)
                line.set_x2(s.loLn, bar_index)
                line.set_color(s.loLn, color.new(sesIndivCol ? s.col : levelCol, f_alpha("taken")))
                if takenMode == "Remove"
                    line.delete(s.loLn)
    [hiSw, loSw]

// Internal (confirmed pivot) liquidity
var array<Piv> pivs = array.new<Piv>()
pivHi = ta.pivothigh(high, pivLen, pivLen)
pivLo = ta.pivotlow(low, pivLen, pivLen)

f_pivAdd(float price, int bar, bool isHigh) =>
    nw = Piv.new(price, bar, isHigh, false, price, 1)
    tol = math.max(eqTolTicks * tick, eqTolAtr * atr)
    if eqOn
        for p in pivs
            if p.isHigh == isHigh and bar - p.bar <= eqMaxAge and math.abs(p.price - price) <= tol
                ext = isHigh ? math.max(p.eqLvl, price) : math.min(p.eqLvl, price)
                p.eq := true
                nw.eq := true
                p.eqLvl := ext
                nw.eqLvl := ext
                nw.eqN := p.eqN + 1
    array.push(pivs, nw)
    while array.size(pivs) > 24
        array.shift(pivs)

// Sweep an internal pivot: returns [hiSweep, loSweep, hiLvl, loLvl]; taken pivots are dropped.
f_pivScan() =>
    hiSw = false
    loSw = false
    hiLvl = float(na)
    loLvl = float(na)
    hiEq = false
    loEq = false
    i = array.size(pivs) - 1
    while i >= 0
        p = array.get(pivs, i)
        lvl = p.eq ? p.eqLvl : p.price
        if p.isHigh and high > lvl
            if math.max(open, close) < lvl and not hiSw
                hiSw := true
                hiLvl := lvl
                hiEq := p.eq and p.eqN >= 2
            array.remove(pivs, i)
        else if not p.isHigh and low < lvl
            if math.min(open, close) > lvl and not loSw
                loSw := true
                loLvl := lvl
                loEq := p.eq and p.eqN >= 2
            array.remove(pivs, i)
        i -= 1
    [hiSw, loSw, hiLvl, loLvl, hiEq, loEq]

// Run of candles closing into the swept extreme: [CISD level = open of the run's first candle, run high, run low, run length]
f_cisd(int d) =>
    k = (d == 1 ? close < open : close > open) ? 0 : 1
    lvl = float(na)
    hi = float(na)
    lo = float(na)
    while k < cisdMaxRun + 1 and k < 400 and (d == 1 ? close[k] < open[k] : close[k] > open[k])
        lvl := open[k]
        hi := na(hi) ? high[k] : math.max(hi, high[k])
        lo := na(lo) ? low[k] : math.min(lo, low[k])
        k += 1
    [lvl, hi, lo, k - 1]

// ───────────────────────────── Engine state ─────────────────────────────
var array<label> sweepMarks = array.new<label>()
var State st = State.new(swDir = 0, swName = "", swExternal = false, reactOK = false, reactType = "", reactDir = 0, lastNote = "", smtDir = 0, smtWho = "", vpDir = 0, vpRole = "", vpLevel = "", vpKind = "", holdCount = 0, vpModel = "", plState = 0, plDir = 0, plTps = array.new<float>(), plHit = 0, plGrade = "", plModel = "", plFamily = "", plLed = "", plVpBasis = "", lastResult = "", lnTps = array.new<line>(), lbTps = array.new<label>(), lastModel = "", lastModelLed = "", nPlans = 0, nWin = 0, nLoss = 0, nFull = 0, nExp = 0, mssOK = false, plBe = false, ideaSes = -1, ideaCount = 0, swHtf = "", brkOK = false, brkUsed = false, oteUsed = false, vpOpenOut = 0, plScore = 0, plPts = "", swUsed = false, mssInWin = false, resweepSkip = false, mssVia = "", trendDir = 0, plTouched = false, plConfirmN = 0, plCeHit = false, nCtrl = 0, nCtrlWin = 0, nCtrlLoss = 0)
var Life sh = Life.new(state = 0, dir = 0, tps = array.new<float>(), hit = 0, be = false, why = "", lastFvgBar = -1, lastFvgTf = "", lastVpBar = -1, lastBrkBar = -1, lastOteBar = -1, nPlans = 0, nWin = 0, nLoss = 0, nFull = 0, nExp = 0, touched = false, confirmN = 0, ceHit = false)
var Life pl = Life.new(state = 0, dir = 0, tps = array.new<float>(), hit = 0, be = false, why = "", lastFvgBar = -1, lastFvgTf = "", lastVpBar = -1, lastBrkBar = -1, lastOteBar = -1, nPlans = 0, nWin = 0, nLoss = 0, nFull = 0, nExp = 0, touched = false, confirmN = 0, ceHit = false)
var Life ct = Life.new(state = 0, dir = 0, tps = array.new<float>(), hit = 0, be = false, why = "", lastFvgBar = -1, lastFvgTf = "", lastVpBar = -1, lastBrkBar = -1, lastOteBar = -1, nPlans = 0, nWin = 0, nLoss = 0, nFull = 0, nExp = 0, touched = false, confirmN = 0, ceHit = false)

// ───────────────────────────── Volume Profile engine ─────────────────────────────
f_newProfile(string kind, float rowSize) =>
    Profile.new(kind = kind, startBar = bar_index, rowSize = rowSize, base = na, vol = array.new<float>(), upv = array.new<float>(), total = 0.0, hi = high, lo = low, done = false, boxes = array.new<box>(), pocIdx = 0, pocVol = 0.0, bars = 0)

f_accRange(Profile p, float h, float l, float vol0, bool isUp) =>
    v = na(vol0) or vol0 <= 0 ? 1.0 : vol0
    iLo = math.floor(l / p.rowSize)
    iHi = math.floor(h / p.rowSize)
    n = iHi - iLo + 1
    curSize = na(p.base) ? 0 : array.size(p.vol)
    spanRows = na(p.base) ? n : math.max(iHi, p.base + curSize - 1) - math.min(iLo, p.base) + 1
    if n > 0 and spanRows <= 4000
        if na(p.base)
            p.base := iLo
            p.vol := array.new<float>(n, 0.0)
            p.upv := array.new<float>(n, 0.0)
        if iLo < p.base
            k = p.base - iLo
            p.vol := array.concat(array.new<float>(k, 0.0), p.vol)
            p.upv := array.concat(array.new<float>(k, 0.0), p.upv)
            p.base := iLo
            p.pocIdx += k
        topIdx = p.base + array.size(p.vol) - 1
        if iHi > topIdx
            k = iHi - topIdx
            p.vol := array.concat(p.vol, array.new<float>(k, 0.0))
            p.upv := array.concat(p.upv, array.new<float>(k, 0.0))
        share = v / n
        up = isUp ? share : 0.0
        for j = iLo to iHi
            idx = j - p.base
            nv = array.get(p.vol, idx) + share
            array.set(p.vol, idx, nv)
            array.set(p.upv, idx, array.get(p.upv, idx) + up)
            // volume only grows, so the POC can only move to a row this bar touched; lowest row wins ties
            if nv > p.pocVol or (nv == p.pocVol and idx < p.pocIdx)
                p.pocVol := nv
                p.pocIdx := idx
        p.total += v
        p.hi := math.max(p.hi, h)
        p.lo := math.min(p.lo, l)

f_acc(Profile p) =>
    p.bars += 1
    nIb = ltfOK and not na(ibV) ? array.size(ibV) : 0
    if nIb > 0
        for i = 0 to nIb - 1
            f_accRange(p, array.get(ibH, i), array.get(ibL, i), array.get(ibV, i), array.get(ibUp, i))
    else if vpDist == "Close only"
        f_accRange(p, close, close, volume, close >= open)
    else
        f_accRange(p, high, low, volume, close >= open)

f_levels(Profile p) =>
    n = array.size(p.vol)
    if n > 0 and p.total > 0
        pocIdx = p.pocIdx
        maxV = p.pocVol
        p.poc := (p.base + pocIdx + 0.5) * p.rowSize
        target = p.total * vpVaPct / 100
        acc = maxV
        lo = pocIdx
        hi = pocIdx
        classic = vaMethod == "Classic (two-row blocks)"
        while acc < target and (lo > 0 or hi < n - 1)
            // the next block above vs below the area; the larger one joins (two rows at a time in the classic method)
            vUp = hi < n - 1 ? array.get(p.vol, hi + 1) + (classic and hi < n - 2 ? array.get(p.vol, hi + 2) : 0.0) : -1.0
            vDn = lo > 0 ? array.get(p.vol, lo - 1) + (classic and lo > 1 ? array.get(p.vol, lo - 2) : 0.0) : -1.0
            if vUp >= vDn
                hi := math.min(n - 1, hi + (classic ? 2 : 1))
                acc += vUp
            else
                lo := math.max(0, lo - (classic ? 2 : 1))
                acc += vDn
        p.vah := (p.base + hi + 1) * p.rowSize
        p.val := (p.base + lo) * p.rowSize

f_drawProfile(Profile p, int x1, int x2, bool fade) =>
    for b in p.boxes
        box.delete(b)
    array.clear(p.boxes)
    n = array.size(p.vol)
    if useHist and n > 0 and p.total > 0
        grp = math.max(1, math.ceil(n / (vpHistMode == "Developing + 3 previous" ? 60.0 : 80.0)))
        gv = array.new<float>()
        gu = array.new<float>()
        i = 0
        while i < n
            v = 0.0
            u = 0.0
            j = i
            while j < math.min(i + grp, n)
                v += array.get(p.vol, j)
                u += array.get(p.upv, j)
                j += 1
            array.push(gv, v)
            array.push(gu, u)
            i += grp
        maxV = array.max(gv)
        if maxV > 0
            histW = x2 - x1
            upC = fade ? color.new(vpUpCol, int(math.min(100, color.t(vpUpCol) + 20))) : vpUpCol
            dnC = fade ? color.new(vpDnCol, int(math.min(100, color.t(vpDnCol) + 20))) : vpDnCol
            for [g, v] in gv
                if v > 0
                    w = math.max(1, math.round(histW * v / maxV))
                    bottom = (p.base + g * grp) * p.rowSize
                    top = (p.base + math.min((g + 1) * grp, n)) * p.rowSize
                    isUp = array.get(gu, g) >= v / 2
                    l = vpPlace == "Left" ? x1 : x2 - w
                    r = vpPlace == "Left" ? x1 + w : x2
                    array.push(p.boxes, box.new(l, top, r, bottom, border_color = color.new(color.white, 100), bgcolor = isUp ? upC : dnC))

f_histW(string kind) =>
    sesSec = kind == "PM" ? 9000 : kind == "NY" ? (vpPmRestart ? 14400 : 23400) : 62100
    math.max(4, math.min(vpWidth, math.round(sesSec / chartSec * 0.12)))

var Profile dev  = na
var Profile ov   = na
var Profile pdAL = na
var Profile pdNY = na
var Profile pdPM = na
var Profile pw   = na
var Profile wk   = na
var array<Profile> doneQ = array.new<Profile>()
var array<line> frozenLines = array.new<line>()

inAL = f_inSess(vpSesAL)
inNYraw = f_inSess(vpSesNY)
inPMraw = f_inSess(vpSesPM)
inPM = vpPmRestart and inPMraw
inNY = inNYraw and not inPM
curKind = inPM ? "PM" : inNY ? "NY" : inAL ? "AL" : ""
newWeek = timeframe.change("W")
newVpSession = false

f_freezeDev(Profile p) =>
    if useVp and showDev and showFrozen and not na(p.poc)
        array.push(frozenLines, line.new(f_x(p.startBar), p.poc, p.endBar, p.poc, color = color.new(chart.fg_color, 70), width = 1))
        while array.size(frozenLines) > 9
            line.delete(array.shift(frozenLines))

f_vpReset() =>
    st.vpDir := 0
    st.vpRole := ""
    st.vpLevel := ""
    st.vpKind := ""
    st.holdCount := 0
    st.vpModel := ""
    if st.swDir != 1 and st.swDir != -1
        st.reactOK := false
        st.reactType := ""

// Each level is compared against its own value on the previous bar, so a moving DEV level cannot fake a cross.
var array<float> vpPrevL = array.new<float>(12, na)
f_lvlIdx(string role, string lvl) =>
    (role == "DEV" ? 0 : role == "OV" ? 1 : role == "PD" ? 2 : 3) * 3 + (lvl == "VAH" ? 0 : lvl == "POC" ? 1 : 2)

if confirmed and useVp
    devKind = ""
    if not na(dev)
        devKind := dev.kind
    if curKind != devKind
        if not na(dev)
            dev.done := true
            dev.endBar := bar_index - 1
            f_levels(dev)
            f_freezeDev(dev)
            // the finished profile becomes OV (a morning NY profile handing over to the PM restart keeps the overnight OV)
            toOv = not (dev.kind == "NY" and curKind == "PM")
            if toOv
                ov := dev
                for k = 0 to 2
                    array.set(vpPrevL, 3 + k, array.get(vpPrevL, k))
            if dev.kind == "AL"
                pdAL := dev
            else if dev.kind == "PM"
                pdPM := dev
            else
                pdNY := dev
            if st.vpDir != 0
                if st.vpRole == "DEV" and toOv
                    st.vpRole := "OV"
                else if st.vpRole != "PW"
                    f_vpReset()
            if useHist and vpHistMode != "Developing only"
                keepN = vpHistMode == "Developing + previous" ? 1 : 3
                while array.size(doneQ) >= keepN
                    old = array.shift(doneQ)
                    for b in old.boxes
                        box.delete(b)
                    array.clear(old.boxes)
                hw = f_histW(dev.kind)
                if vpPlace == "Left"
                    f_drawProfile(dev, f_x(dev.startBar), f_x(dev.startBar) + hw, true)
                else
                    f_drawProfile(dev, f_x(math.max(dev.startBar, dev.endBar - hw)), dev.endBar, true)
                array.push(doneQ, dev)
            else
                for b in dev.boxes
                    box.delete(b)
                array.clear(dev.boxes)
        dev := na
        newVpSession := true
        if curKind != ""
            ref = curKind == "AL" ? pdAL : curKind == "PM" ? (na(pdPM) ? pdNY : pdPM) : pdNY
            rng = pdRange * 0.6
            if not na(ref)
                rng := math.max(ref.hi - ref.lo, atr * 5)
            rs = math.max(tick, nz(math.round_to_mintick(rng / vpRows), tick))
            dev := f_newProfile(curKind, rs)
            // 80 % rule context: did this session open outside the previous session's value area?
            st.vpOpenOut := 0
            if not na(ov)
                if not na(ov.poc)
                    st.vpOpenOut := close > ov.vah ? 1 : close < ov.val ? -1 : 0
    if not na(dev)
        f_acc(dev)
        f_levels(dev)
    if showPw
        if newWeek
            if not na(wk)
                wk.done := true
                wk.endBar := bar_index - 1
                f_levels(wk)
                pw := wk
            wk := f_newProfile("W", math.max(tick, nz(math.round_to_mintick(pdRange * 3 / vpRows), tick)))
        if not na(wk)
            f_acc(wk)

f_devNeed() =>
    // never demand more than a quarter of the session's bars, so DEV still becomes eligible on 5m / 15m charts
    sesSec = na(dev) ? 62100 : dev.kind == "PM" ? 9000 : dev.kind == "NY" ? (vpPmRestart ? 14400 : 23400) : 62100
    math.min(devMinBars, math.max(1, math.round(sesSec / chartSec / 4.0)))

f_devEligible() =>
    r = false
    if not na(dev)
        if not na(dev.poc)
            r := dev.bars >= f_devNeed()
    r

devEligible = f_devEligible()

f_roleProfile(string role) =>
    Profile p = role == "DEV" ? (devEligible ? dev : Profile(na)) : role == "OV" ? ov : role == "PW" ? pw : Profile(na)
    if role == "PD" and not na(dev)
        p := dev.kind == "AL" ? pdAL : dev.kind == "PM" ? pdPM : pdNY
    p

f_roleShown(string role) =>
    role == "DEV" ? showDev : role == "OV" ? showOv : role == "PD" ? showPd : showPw

// disp = true returns the developing profile's levels even before it is eligible (drawing only)
f_levelVal(string role, string lvl, bool disp) =>
    Profile p = disp and role == "DEV" ? dev : f_roleProfile(role)
    float r = na
    if not na(p)
        if not na(p.poc)
            r := lvl == "VAH" ? p.vah : lvl == "POC" ? p.poc : p.val
    r

var array<string> vpRoles = array.from("DEV", "OV", "PD", "PW")
var array<string> vpLvls  = array.from("VAH", "POC", "VAL")

// Location relative to the active reference profile (DEV once eligible, else OV).
refRole = devEligible ? "DEV" : "OV"
refVah = f_levelVal(refRole, "VAH", false)
refVal = f_levelVal(refRole, "VAL", false)
vpLocation = na(refVah) ? "No profile yet" : close > refVah ? "Above " + refRole + " VAH" : close < refVal ? "Below " + refRole + " VAL" : "Inside " + refRole + " value"

// ── VP context: cross → rotation (re-entry / POC) or continuation (breakout) ──
if confirmed and useVp
    newDir = 0
    newRole = ""
    newLvl = ""
    newKind = ""
    bestL = float(na)
    for role in vpRoles
        if f_roleShown(role)
            for lvl in vpLvls
                L = f_levelVal(role, lvl, false)
                // session-open bar: DEV is not eligible yet, OV carries the finished profile's previous values, PD / PW are static
                Lp = (newVpSession and (role == "PD" or role == "PW")) or (newWeek and role == "PW") ? L : array.get(vpPrevL, f_lvlIdx(role, lvl))
                if not na(L) and not na(Lp) and (not newVpSession or role != "DEV") and not (lunchQuiet and lunchNow)
                    up = close > L and close[1] <= math.min(L, Lp)
                    dn = close < L and close[1] >= math.max(L, Lp)
                    if (up or dn) and (na(bestL) or (up ? L > bestL : L < bestL))
                        bestL := L
                        newDir := up ? 1 : -1
                        newRole := role
                        newLvl := lvl
                        newKind := (lvl == "VAL" and up) or (lvl == "VAH" and dn) or lvl == "POC" ? "Rotation" : "Continuation"
    if newDir != 0 and (st.vpDir != newDir or st.holdCount == 0 or st.vpModel != "" or st.vpKind != "Rotation")
        st.vpDir := newDir
        st.vpRole := newRole
        st.vpLevel := newLvl
        st.vpKind := newKind
        st.vpBar := bar_index
        st.holdCount := 0
        st.holdExt := newDir == 1 ? low : high
        st.vpModel := ""
        if st.swDir != 1 and st.swDir != -1 and st.reactDir != st.vpDir
            st.reactOK := false
            st.reactType := ""
    // a model that was not turned into a plan on its own bar is dropped; the context stays alive
    if st.vpDir != 0 and st.vpModel != "" and st.vpModelBar < bar_index
        st.vpModel := ""
    if st.vpDir != 0 and st.vpModel == ""
        L = f_levelVal(st.vpRole, st.vpLevel, false)
        d = st.vpDir
        if na(L) or bar_index - st.vpBar > vpWindow or (d == 1 ? close < L - atr : close > L + atr)
            f_vpReset()
        else if bar_index > st.vpBar
            onSide = d == 1 ? close > L + 0.1 * atr : close < L - 0.1 * atr
            if onSide
                st.holdCount += 1
                st.holdExt := d == 1 ? math.min(st.holdExt, low) : math.max(st.holdExt, high)
            else
                st.holdCount := 0
                st.holdExt := d == 1 ? low : high
            retest = d == 1 ? (low <= L and close > L) : (high >= L and close < L)
            if st.vpKind == "Rotation"
                if retest
                    st.vpModel := "VP Retest"
                    st.vpModelBar := bar_index
                    st.vpModelExt := d == 1 ? low : high
                else if st.holdCount >= holdBars and math.abs(close - L) <= holdMaxAtr * atr
                    st.vpModel := "VP Hold"
                    st.vpModelBar := bar_index
                    st.vpModelExt := st.holdExt
    for role in vpRoles
        for lvl in vpLvls
            array.set(vpPrevL, f_lvlIdx(role, lvl), f_levelVal(role, lvl, false))


newDay = not na(pdTime) and (na(pdTime[1]) or pdTime != pdTime[1])
oppHi  = ta.highest(high, mssLook)[1]   // short-term high / low just before the current bar (market structure shift reference)
oppLo  = ta.lowest(low, mssLook)[1]
oppHiBar = bar_index - 1 + ta.highestbars(high, mssLook)[1]
oppLoBar = bar_index - 1 + ta.lowestbars(low, mssLook)[1]
var int sesOpenTime = na
var int twoSidedBar = na

sweepHiExt = false
sweepLoExt = false
sweepHiName = ""
sweepLoName = ""
sweepHiLvl = float(na)
sweepLoLvl = float(na)

if confirmed
    for [i, s] in sessions
        if s.show and not s.isPd and array.get(inSesArr, i) and not s.active
            sesOpenTime := time
        [a, b] = f_sesUpdate(s, array.get(inSesArr, i), newDay)
        if a and (na(sweepHiLvl) or s.hi > sweepHiLvl)
            sweepHiExt := true
            sweepHiName := s.isPd ? "PDH" : s.name + " High"
            sweepHiLvl := s.hi
        if b and (na(sweepLoLvl) or s.lo < sweepLoLvl)
            sweepLoExt := true
            sweepLoName := s.isPd ? "PDL" : s.name + " Low"
            sweepLoLvl := s.lo
    if useInternal
        if not na(pivHi)
            f_pivAdd(pivHi, bar_index - pivLen, true)
        if not na(pivLo)
            f_pivAdd(pivLo, bar_index - pivLen, false)

intHiSw = false
intLoSw = false
intHiLvl = float(na)
intLoLvl = float(na)
intHiEq = false
intLoEq = false
if confirmed and useInternal
    [a, b, c, d, eqH, eqL] = f_pivScan()
    intHiSw := a
    intLoSw := b
    intHiLvl := c
    intLoLvl := d
    intHiEq := eqH
    intLoEq := eqL

hiSweep = sweepHiExt or intHiSw
loSweep = sweepLoExt or intLoSw
sweepEvent = false
reactEvent = false
var array<label> reactMarks = array.new<label>()

if confirmed
    // ── Step 1: recognized sweep (external priority, two-sided = review) ──
    // A candle that sweeps an external level on one side and only an internal pivot on the other takes the external side.
    twoSided = hiSweep and loSweep and (sweepHiExt == sweepLoExt)
    if hiSweep and loSweep and not twoSided
        hiSweep := sweepHiExt
        loSweep := sweepLoExt
    if twoSided
        st.swDir := 2
        st.swName := "Two-sided"
        twoSidedBar := bar_index
        st.swBar := bar_index
        st.swExternal := sweepHiExt or sweepLoExt
        st.reactOK := false
        st.reactType := ""
        st.swOpp := float(na)
        st.mssOK := false
        st.swHtf := ""
        sweepEvent := true
    else if hiSweep or loSweep
        newDir  = hiSweep ? -1 : 1
        newName = hiSweep ? (sweepHiExt ? sweepHiName : intHiEq ? "EQH" : "Internal High") : (sweepLoExt ? sweepLoName : intLoEq ? "EQL" : "Internal Low")
        newLvl  = hiSweep ? (sweepHiExt ? sweepHiLvl : intHiLvl) : (sweepLoExt ? sweepLoLvl : intLoLvl)
        // A shallower same-direction re-sweep inside a reaction-confirmed idea (a pullback wicking a minor
        // level) is fresh evidence for the SAME trade idea: keep the thesis sweep, its extreme, its start bar
        // and the confirmed reaction so the displacement FVG stays eligible. Only a deeper or opposite-side
        // sweep starts a new idea.
        sameIdea = st.swDir == newDir and st.reactOK and (newDir == 1 ? low > st.swExt : high < st.swExt)
        keepExt = st.swDir == -newDir and st.swExternal and st.reactOK and not (hiSweep ? sweepHiExt : sweepLoExt)
        if not sameIdea and not keepExt
            // an internal re-sweep deeper than a live external sweep extends that external idea instead of demoting it
            extendExt = st.swDir == newDir and st.swExternal and not (hiSweep ? sweepHiExt : sweepLoExt)
            // a same-direction sweep deeper than the wick a pending plan was built on re-bases that plan too (see the expiry before the lifecycle step)
            if st.plState == 1 and st.plDir == newDir and st.swDir == newDir and (newDir == 1 ? low < st.swExt : high > st.swExt)
                st.rebaseBar := bar_index
            st.swDir := newDir
            st.swExternal := (hiSweep ? sweepHiExt : sweepLoExt) or (hiSweep ? intHiEq : intLoEq) or extendExt
            st.swName := extendExt ? st.swName : newName
            st.swLevel := extendExt ? st.swLevel : newLvl
            st.swExt := extendExt ? (hiSweep ? math.max(nz(st.swExt, high), high) : math.min(nz(st.swExt, low), low)) : (hiSweep ? high : low)
            st.swBar := bar_index
            st.reactOK := false
            st.reactType := ""
            // market structure shift reference: the short-term high (low sweep) / low (high sweep) just before the sweep
            st.swOpp := hiSweep ? oppLo : oppHi
            st.swOppBar := hiSweep ? oppLoBar : oppHiBar
            st.mssOK := hiSweep ? close < st.swOpp : close > st.swOpp
            st.legExt := hiSweep ? low : high
            st.swHtf := ""
            st.brkOK := false
            st.brkUsed := false
            st.oteUsed := false
            st.swUsed := false
            st.legExtBar := bar_index
            st.mssVia := ""
            [cl, ch, cL, cn] = f_cisd(newDir)
            st.cisdLvl := cl
            st.cisdRunHi := ch
            st.cisdRunLo := cL
            st.cisdBar := bar_index - cn
        sweepEvent := true
        if useSweepMk and (sweepMarkIn == "All" or (hiSweep ? sweepHiExt : sweepLoExt) or (hiSweep ? intHiEq : intLoEq))
            extMk = (hiSweep ? sweepHiExt : sweepLoExt) or (hiSweep ? intHiEq : intLoEq)
            array.push(sweepMarks, label.new(bar_index, hiSweep ? high : low, "", style = label.style_circle, color = color.new(hiSweep ? bearCol : bullCol, extMk ? 40 : 75), size = size.tiny, tooltip = "Sweep · " + newName + " · " + f_price(newLvl)))
            while array.size(sweepMarks) > 20
                label.delete(array.shift(sweepMarks))
    // ── Trade-idea extreme: always the lowest / highest print since the sweep. A deeper print re-bases the idea:
    //    new displacement and structure shift required, a pending plan expires, an active plan keeps its stop ──
    if (st.swDir == 1 or st.swDir == -1) and sweepEvent == false
        dx = st.swDir
        if (dx == 1 ? low < st.swExt : high > st.swExt) and st.plState != 2
            st.swOpp := dx == 1 ? oppHi : oppLo
            st.swOppBar := dx == 1 ? oppHiBar : oppLoBar
            st.mssOK := false
            st.brkOK := false
            st.oteUsed := false
            st.reactOK := false
            st.reactType := ""
            st.swBar := bar_index
            st.legExt := dx == 1 ? high : low
            st.legExtBar := bar_index
            st.swUsed := false
            st.rebaseBar := bar_index
            st.mssVia := ""
            [cl, ch, cL, cn] = f_cisd(dx)
            st.cisdLvl := cl
            st.cisdRunHi := ch
            st.cisdRunLo := cL
            st.cisdBar := bar_index - cn
        st.swExt := dx == 1 ? math.min(st.swExt, low) : math.max(st.swExt, high)
    // ── Step 4: displacement / sharp reversal in the working direction (sweep first, else VP context) ──
    ctxDir = (st.swDir == 1 or st.swDir == -1) ? st.swDir : st.vpDir
    if ctxDir != 0 and (not st.reactOK or st.reactDir != ctxDir or st.reactType == "Sharp Reversal")
        d = ctxDir
        fresh = not st.reactOK or st.reactDir != d
        isDisp = bodySz >= dispAtr * atr and rangeSz > 0 and bodySz / rangeSz >= 0.5 and (d == 1 ? close > open and close > high[1] : close < open and close < low[1])
        lowerWick = math.min(open, close) - low
        upperWick = high - math.max(open, close)
        isSharp = rangeSz >= atr * 1.2 and (d == 1 ? lowerWick >= wickMult * bodySz and close > (high + low) / 2 : upperWick >= wickMult * bodySz and close < (high + low) / 2)
        if isDisp or (isSharp and fresh)
            st.reactOK := true
            st.reactDir := d
            st.reactType := isDisp ? "Displacement" : "Sharp Reversal"
            st.reactBar := bar_index
            st.reactExt := d == 1 ? low : high
            reactEvent := true
            if useReactTri
                array.push(reactMarks, label.new(bar_index, d == 1 ? low : high, "", style = d == 1 ? label.style_triangleup : label.style_triangledown, color = d == 1 ? bullCol : bearCol, size = size.tiny))
                while array.size(reactMarks) > 60
                    label.delete(array.shift(reactMarks))
    // ── Structure shift: CISD (close through the open of the run into the sweep) and / or the 10-bar swing break ──
    if (st.swDir == 1 or st.swDir == -1) and not st.mssOK
        oldOK = not na(st.swOpp) and (st.swDir == 1 ? close > st.swOpp : close < st.swOpp)
        cisdOK = not na(st.cisdLvl) and (st.swDir == 1 ? close > st.cisdLvl : close < st.cisdLvl)
        shiftOK = mssMode == "CISD" ? cisdOK : mssMode == "10-bar high / low" ? oldOK : mssMode == "Both" ? (oldOK and cisdOK) : (oldOK or cisdOK)
        if shiftOK
            st.mssOK := true
            st.mssBar := bar_index
            st.mssInWin := inKzAm or inKzPm or inSbAm or inSbPm
            st.mssVia := cisdOK and mssMode != "10-bar high / low" ? "CISD" : "MSS"
            st.brkOK := false
            // breaker block: a small CISD run is the breaker itself; otherwise the last candle that closed in the old direction at the broken swing
            if cisdOK and not na(st.cisdRunHi) and st.cisdRunHi - st.cisdRunLo <= 1.5 * atr
                st.brkTop := st.cisdRunHi
                st.brkBot := st.cisdRunLo
                st.brkBar := st.cisdBar
                st.brkOK := true
                st.brkUsed := false
            else
                k0 = math.max(0, bar_index - nz(st.swOppBar, bar_index))
                for k = k0 to k0 + 3
                    if not st.brkOK and k < 400
                        if (st.swDir == 1 ? close[k] > open[k] : close[k] < open[k])
                            st.brkTop := high[k]
                            st.brkBot := low[k]
                            st.brkBar := bar_index - k
                            st.brkOK := true
                            st.brkUsed := false
    // a breaker that price closes through against the idea has failed
    if st.brkOK and (st.swDir == 1 ? close < st.brkBot : close > st.brkTop)
        st.brkOK := false
    // ── Displacement leg: farthest print since the sweep (and the bar that printed it) ──
    if st.swDir == 1 or st.swDir == -1
        newLeg = st.swDir == 1 ? math.max(nz(st.legExt, high), high) : math.min(nz(st.legExt, low), low)
        st.legExtBar := newLeg != st.legExt ? bar_index : st.legExtBar
        st.legExt := newLeg
    // ── Context expiry / invalidation ──
    if st.swDir != 0
        aged = bar_index - st.swBar
        if st.swDir == 2 and aged > reactWindow
            st.swDir := 0
        else if (st.swDir == 1 or st.swDir == -1)
            if not st.reactOK and aged > reactWindow
                st.swDir := 0
            else if st.reactOK and bar_index - st.reactBar > thesisWindow
                st.swDir := 0
            else if st.reactOK and (st.swDir == 1 ? close < st.swExt : close > st.swExt)
                st.swDir := 0
            if st.swDir == 0
                st.reactOK := false
                st.reactType := ""
                st.mssOK := false
                st.brkOK := false

// ───────────────────────────── Day type ─────────────────────────────
if confirmed
    st.trendDir := trendLock == "Off" or not ibDone or ibBoth ? 0 : voteUp ? 1 : voteDn ? -1 : 0

// ───────────────────────────── SMT divergence ─────────────────────────────
f_symShort(string sym) =>
    parts = str.split(sym, ":")
    s = array.get(parts, array.size(parts) - 1)
    str.replace_all(str.replace_all(s, "1!", ""), "!", "")

smtPh = ta.pivothigh(high, smtPiv, smtPiv)
smtPl = ta.pivotlow(low, smtPiv, smtPiv)
var float prevPh = na
var float prevPhC1 = na
var float prevPhC2 = na
var int   prevPhBar = na
var float prevPl = na
var float prevPlC1 = na
var float prevPlC2 = na
var int   prevPlBar = na
smtEvent = false

var array<line>  smtLines  = array.new<line>()
var array<label> smtLabels = array.new<label>()

f_smtDraw(int x1, float y1, int x2, float y2, string who, int dir) =>
    if useSmt
        c = dir == 1 ? bullCol : bearCol
        xa = f_x(x1)
        array.push(smtLines, line.new(xa, y1, x2, y2, color = color.new(c, 30), width = 1, style = line.style_dashed))
        array.push(smtLabels, label.new(x2, y2, "SMT " + who, style = dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(c, 85), textcolor = c, size = lblSz, tooltip = (dir == 1 ? "Bullish" : "Bearish") + " SMT · " + who + (dir == 1 ? "\nChart made a lower low, " : "\nChart made a higher high, ") + who + " did not"))
        while array.size(smtLines) > 2
            line.delete(array.shift(smtLines))
            label.delete(array.shift(smtLabels))

if confirmed and (smtOn1 or smtOn2)
    if not na(smtPh)
        c1 = cmpT1[smtPiv] == time[smtPiv] and cmpT1[smtWin - 1] == time[smtWin - 1] ? cmpHi1 : float(na)
        c2 = cmpT2[smtPiv] == time[smtPiv] and cmpT2[smtWin - 1] == time[smtWin - 1] ? cmpHi2 : float(na)
        pb = bar_index - smtPiv
        if not na(prevPh) and smtPh > prevPh
            d1 = smtOn1 and not na(c1) and not na(prevPhC1) and c1 < prevPhC1
            d2 = smtOn2 and not na(c2) and not na(prevPhC2) and c2 < prevPhC2
            if d1 or d2
                st.smtDir := -1
                st.smtBar := bar_index
                st.smtWho := d1 and d2 ? f_symShort(smtSym1) + "/" + f_symShort(smtSym2) : d1 ? f_symShort(smtSym1) : f_symShort(smtSym2)
                smtEvent := true
                f_smtDraw(prevPhBar, prevPh, pb, smtPh, st.smtWho, -1)
        prevPh := smtPh
        prevPhC1 := c1
        prevPhC2 := c2
        prevPhBar := pb
    if not na(smtPl)
        c1 = cmpT1[smtPiv] == time[smtPiv] and cmpT1[smtWin - 1] == time[smtWin - 1] ? cmpLo1 : float(na)
        c2 = cmpT2[smtPiv] == time[smtPiv] and cmpT2[smtWin - 1] == time[smtWin - 1] ? cmpLo2 : float(na)
        pb = bar_index - smtPiv
        if not na(prevPl) and smtPl < prevPl
            d1 = smtOn1 and not na(c1) and not na(prevPlC1) and c1 > prevPlC1
            d2 = smtOn2 and not na(c2) and not na(prevPlC2) and c2 > prevPlC2
            if d1 or d2
                st.smtDir := 1
                st.smtBar := bar_index
                st.smtWho := d1 and d2 ? f_symShort(smtSym1) + "/" + f_symShort(smtSym2) : d1 ? f_symShort(smtSym1) : f_symShort(smtSym2)
                smtEvent := true
                f_smtDraw(prevPlBar, prevPl, pb, smtPl, st.smtWho, 1)
        prevPl := smtPl
        prevPlC1 := c1
        prevPlC2 := c2
        prevPlBar := pb

smtFresh = st.smtDir != 0 and bar_index - st.smtBar <= smtValid

// ───────────────────────────── FVG engine ─────────────────────────────
var array<Fvg> fvgs = array.new<Fvg>()
var array<Fvg> htf1 = array.new<Fvg>()
var array<Fvg> htf2 = array.new<Fvg>()
var array<Fvg> htf3 = array.new<Fvg>()
var array<Fvg> htf4 = array.new<Fvg>()
var array<Fvg> htf5 = array.new<Fvg>()
var array<Fvg> htf6 = array.new<Fvg>()
minGap = math.max(minFvgPts, minFvgAtr * atr)
var int fvgSes = 0
if confirmed and curKind != curKind[1]
    fvgSes += 1

f_fvgAdd(array<Fvg> arr, float top, float bottom, int dir, int barIdx, string tfLbl, bool isHtf, int cap, bool rightSide, bool light) =>
    // evict before creating so the box budget is never exceeded, dead gaps first
    while array.size(arr) >= cap
        k = -1
        for i = 0 to array.size(arr) - 1
            if k == -1 and array.get(arr, i).state == 2
                k := i
        old = array.remove(arr, k == -1 ? 0 : k)
        box.delete(old.bx)
        line.delete(old.ce)
    dirCol = dir == 1 ? bullCol : bearCol
    bg0 = dir == 1 ? fvgBullCol : fvgBearCol
    bg = light ? color.new(bg0, math.min(100, int(color.t(bg0)) + 4)) : bg0   // mapped 15m+ zones a touch lighter so stacks do not go dark
    bx = box.new(barIdx, top, bar_index + 5, bottom, border_color = light ? color.new(dirCol, 60) : color.new(bg, 100), border_width = 1, border_style = light ? line.style_dashed : line.style_solid, bgcolor = bg, extend = extend.none, text = fvgLblMode == "None" or (fvgLblMode == "15m+ and IFVG only" and not light) ? "" : tfLbl + (fvgLblMode == "{tf} FVG" ? " FVG" : ""), text_size = fvgTxtSz, text_color = color.new(dirCol, 15), text_halign = text.align_left, text_valign = text.align_center)
    line ce = na
    if showCe
        ce := line.new(barIdx, (top + bottom) / 2, bar_index + 4, (top + bottom) / 2, color = color.new(dirCol, 50), style = line.style_dotted, extend = extend.none)
    array.push(arr, Fvg.new(bx, ce, top, bottom, dir, barIdx, 0, na, tfLbl, rightSide, false, fvgSes, false, 0, -1, inKzAm or inKzPm, inSbAm or inSbPm, close, close))

f_fvgFreeze(Fvg f) =>
    if f.rightSide
        // parked boxes live right of price; freezing them at bar_index would invert the box
        box.delete(f.bx)
        line.delete(f.ce)
    else
        box.set_right(f.bx, bar_index)
        if not na(f.ce)
            line.set_x2(f.ce, bar_index)

// Live gaps end a few bars past price (like the original) instead of running to the chart edge.
// Close-through invalidation. Chart-TF gaps invert into IFVGs; HTF gaps simply end.
f_fvgUpdate(array<Fvg> arr, bool isHtf, float px) =>
    i = array.size(arr) - 1
    while i >= 0
        f = array.get(arr, i)
        if f.state == 0
            if (f.dir == 1 and px < f.bottom) or (f.dir == -1 and px > f.top)
                f.invBar := bar_index
                owned = not isHtf and st.swDir == -f.dir
                if owned
                    f.state := 1
                    f.used := false   // the inverted zone is a new zone: a gap spent on a retest plan can still trade as an IFVG
                    box.set_bgcolor(f.bx, ifvgCol)
                    box.set_text(f.bx, f.tf + " IFVG")
                    box.set_text_color(f.bx, color.new(f.dir == 1 ? bearCol : bullCol, 15))
                else
                    f.state := 2
                    f_fvgFreeze(f)
        else if f.state == 1
            if (f.dir == 1 and px > f.top) or (f.dir == -1 and px < f.bottom)
                f.state := 2
                f.invBar := bar_index
                f_fvgFreeze(f)
        if isPresent and f.state != 2 and bar_index - f.barIdx > presentBars
            f.state := 2
            f.invBar := bar_index
            f_fvgFreeze(f)
        if f.state == 2 and bar_index - f.invBar > (f.traded ? 150 : 0)
            box.delete(f.bx)
            line.delete(f.ce)
            array.remove(arr, i)
        i -= 1

if useFvg and confirmed
    f_fvgUpdate(fvgs, false, close)
    bullGap = low - high[2]
    bearGap = low[2] - high
    if bullGap > 0 and bullGap >= minGap and (not midClose or close[1] > high[2])
        f_fvgAdd(fvgs, low, high[2], 1, bar_index - 1, chartTfLabel, false, maxFvg, false, false)
    if bearGap > 0 and bearGap >= minGap and (not midClose or close[1] < low[2])
        f_fvgAdd(fvgs, low[2], high, -1, bar_index - 1, chartTfLabel, false, maxFvg, false, false)

var array<int> htfOpen1 = array.new<int>()
var array<int> htfOpen2 = array.new<int>()
var array<int> htfOpen3 = array.new<int>()
var array<int> htfOpen4 = array.new<int>()
var array<int> htfOpen5 = array.new<int>()
var array<int> htfOpen6 = array.new<int>()

f_htfProcess(array<Fvg> arr, array<int> opens, bool enabled, string tf, float h1, float l1, float c1, float h2, float l2, float c2, float h3, float l3, int t1) =>
    sec = timeframe.in_seconds(tf)
    ok = enabled and useHtf and sec > chartSec
    newBar = t1 != t1[1]
    if ok and confirmed and newBar
        array.push(opens, bar_index)            // first chart bar of each HTF bar
        if array.size(opens) > 4
            array.shift(opens)
    if ok and confirmed and newBar and not na(h3) and not na(t1[1])
        f_fvgUpdate(arr, true, c1)
        rs = isLtf and htfPlace == "Right Side" and sec >= 900
        nOpen = array.size(opens)
        anchor = f_x(nOpen >= 3 ? array.get(opens, nOpen - 3) : bar_index)   // open bar of the displacement candle, within drawing reach
        minH = math.max(minGap, htfMinPts)
        gapB = l1 - h3
        gapS = l3 - h1
        if gapB > 0 and gapB >= minH and (not midClose or c2 > h3)
            f_fvgAdd(arr, l1, h3, 1, anchor, f_tfLabel(tf), true, maxHtf, rs, sec >= 900)
        if gapS > 0 and gapS >= minH and (not midClose or c2 < l3)
            f_fvgAdd(arr, l3, h1, -1, anchor, f_tfLabel(tf), true, maxHtf, rs, sec >= 900)

f_htfProcess(htf1, htfOpen1, htfOn1, htfTf1, h1a, l1a, c1a, h2a, l2a, c2a, h3a, l3a, t1a)
f_htfProcess(htf2, htfOpen2, htfOn2, htfTf2, h1b, l1b, c1b, h2b, l2b, c2b, h3b, l3b, t1b)
f_htfProcess(htf3, htfOpen3, htfOn3, htfTf3, h1c, l1c, c1c, h2c, l2c, c2c, h3c, l3c, t1c)
f_htfProcess(htf4, htfOpen4, htfOn4, htfTf4, h1d, l1d, c1d, h2d, l2d, c2d, h3d, l3d, t1d)
f_htfProcess(htf5, htfOpen5, htfOn5, htfTf5, h1e, l1e, c1e, h2e, l2e, c2e, h3e, l3e, t1e)
f_htfProcess(htf6, htfOpen6, htfOn6, htfTf6, h1f, l1f, c1f, h2f, l2f, c2f, h3f, l3f, t1f)

// Respect pass: a zone is "respected" when a chart bar comes from outside, taps its near edge, stays inside it and
// closes back off it. Active gaps hold from f.dir; an inverted gap (IFVG) holds from the opposite side.
f_respectPass(array<Fvg> arr) =>
    for f in arr
        if f.state != 2 and bar_index > f.barIdx + 1 and f.lastTouch != bar_index
            zd = f.state == 1 ? -f.dir : f.dir
            held = zd == 1 ? (low <= f.top and close > f.top and low > f.bottom and low[1] > f.top) : (high >= f.bottom and close < f.bottom and high < f.top and high[1] < f.bottom)
            if held
                f.resp += 1
                f.lastTouch := bar_index

f_trackClose(array<Fvg> arr) =>
    for f in arr
        if f.state == 0
            f.minClose := math.min(f.minClose, close)
            f.maxClose := math.max(f.maxClose, close)

if useFvg and confirmed
    f_trackClose(fvgs)
    f_trackClose(htf1)
    f_trackClose(htf2)
    f_respectPass(fvgs)
    f_respectPass(htf1)
    f_respectPass(htf2)
    f_respectPass(htf3)
    f_respectPass(htf4)
    f_respectPass(htf5)
    f_respectPass(htf6)

// HTF confluence: price inside (or just reacted from) an active HTF gap in direction d.
f_htfTouch(array<Fvg> arr, int d) =>
    r = ""
    for f in arr
        if f.state == 0 and f.dir == d and r == "" and lo6 <= f.top and hi6 >= f.bottom
            r := f.tf
    r

f_htfTouchTf(array<Fvg> arr, int d, string tf) =>
    timeframe.in_seconds(tf) >= 900 ? f_htfTouch(arr, d) : ""

f_htfAligned(int d) =>
    r = f_htfTouchTf(htf1, d, htfTf1)
    r := r != "" ? r : f_htfTouchTf(htf2, d, htfTf2)
    r := r != "" ? r : f_htfTouchTf(htf3, d, htfTf3)
    r := r != "" ? r : f_htfTouchTf(htf4, d, htfTf4)
    r := r != "" ? r : f_htfTouchTf(htf5, d, htfTf5)
    r := r != "" ? r : f_htfTouchTf(htf6, d, htfTf6)
    r

// Checklist step 2: remember the first mapped 15m+ gap in the idea's direction that price touched since the sweep.
if confirmed and (st.swDir == 1 or st.swDir == -1) and st.swHtf == ""
    st.swHtf := f_htfAligned(st.swDir)

// ───────────────────────────── Plan management ─────────────────────────────
f_planFreeze() =>
    if not na(st.lnEntry)
        line.set_x2(st.lnEntry, bar_index)
        line.set_x2(st.lnSl, bar_index)
        for ln in st.lnTps
            line.set_x2(ln, bar_index)
    if not na(st.bxRisk)
        box.set_right(st.bxRisk, bar_index)
        box.set_right(st.bxReward, bar_index)

f_planClear() =>
    line.delete(st.lnEntry)
    line.delete(st.lnSl)
    box.delete(st.bxRisk)
    box.delete(st.bxReward)
    box.delete(st.bxZone)
    for ln in st.lnTps
        line.delete(ln)
    array.clear(st.lnTps)

var array<label> ideaMarks = array.new<label>()
var array<int>   ideaMarkT = array.new<int>()
f_pruneMarks() =>
    while array.size(ideaMarks) > markKeep or (isPresent and array.size(ideaMarkT) > 0 and bar_index - array.get(ideaMarkT, 0) > presentBars)
        label.delete(array.shift(ideaMarks))
        array.shift(ideaMarkT)

// tag beyond the idea's original stop: grade · L / S · outcome. Saved ideas solid, shadow ideas faint with the reason in the hover text.
f_markTag(int bar, int dir, string grade, int hit, int nT, float entry, float R, string family, string model, string led, string result, int state, string why) =>
    if useIdeaMk
        win = hit >= 1
        shadow = why != ""
        y = dir == 1 ? entry - R : entry + R
        txt = grade + " " + (win ? "✓" : state == 4 ? "✗" : "○")
        c = win ? bullCol : state == 4 ? bearCol : color.gray
        tip = (shadow ? "Not saved · " + why + "\n" : "Saved idea\n") + family + " · " + model + " (" + led + ")\nEntry " + f_price(entry) + " · SL " + f_price(y) + " · R " + f_price(R) + "\nTargets hit: " + str.tostring(hit) + "/" + str.tostring(nT) + "\n" + result
        array.push(ideaMarks, label.new(f_x(bar), y, txt, style = dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.white, 100), textcolor = color.new(c, shadow ? 70 : 25), size = markSize, tooltip = tip))
        array.push(ideaMarkT, bar_index)
        f_pruneMarks()

f_markIdea(int state) =>
    f_markTag(st.plBar, st.plDir, st.plGrade, st.plHit, array.size(st.plTps), st.plEntry, st.plR, st.plFamily, st.plModel, st.plLed, st.lastResult, state, "")

// One bar of a pending / active lifecycle (plan, shadow or control). Returns [endState, result, activated]:
// endState 0 = still running · 3 complete · 4 stopped · 5 expired.
f_lifeStep(Life L, bool useFill) =>
    d = L.dir
    n = array.size(L.tps)
    endState = 0
    result = ""
    activated = false
    if L.state == 1
        L.touched := L.touched or (d == 1 ? low <= L.entry : high >= L.entry)
        held = not useFill or not confirmFill or (d == 1 ? close > L.entry + confirmDistAtr * atrRisk : close < L.entry - confirmDistAtr * atrRisk)
        ceLvl = (L.zTop + L.zBot) / 2
        if useFill and ceDowngrade and not na(L.zTop) and not na(L.far) and not L.ceHit and (d == 1 ? L.entry > ceLvl and low <= ceLvl : L.entry < ceLvl and high >= ceLvl)
            L.ceHit := true
            L.entry := ceLvl
            L.sl := d == 1 ? L.far - L.buf : L.far + L.buf
            L.R := math.abs(L.entry - L.sl)
        zoneFail = useFill and confirmFill and not na(L.far) and (d == 1 ? close < L.far : close > L.far)
        ceFail = useFill and ceDowngrade and L.ceHit and (d == 1 ? close < ceLvl : close > ceLvl)
        // a retest wick through the far edge of an FVG / IFVG zone is a full fill: no entry (④ 'Retest must not fill the whole gap')
        fullFill = useFill and noFullFill and not na(L.far) and not na(L.fvg) and (d == 1 ? low < L.far : high > L.far)
        if bar_index - L.bar > pendingBars
            endState := 5
            result := "Expired · no activation"
        else if (d == 1 ? low <= L.sl : high >= L.sl)
            endState := useFill and confirmFill ? 5 : 4
            result := useFill and confirmFill ? "Expired · stop swept before entry" : "Setup Invalid · SL before activation"
        else if zoneFail or ceFail or fullFill
            endState := 5
            result := fullFill ? "Expired · full fill before entry" : "Expired · zone failed before entry"
        else if L.touched and held
            L.confirmN += 1
            if L.confirmN >= (useFill ? confirmBars : 1)
                L.state := 2
                activated := true
        else
            L.confirmN := 0
    if L.state == 2 and endState == 0
        if (d == 1 ? low <= L.sl : high >= L.sl)
            endState := L.be ? (L.hit >= 1 ? 4 : 5) : 4
            result := L.be ? (L.hit >= 1 ? "Breakeven · stopped at entry after TP" + str.tostring(L.hit) : "Breakeven · scratch at entry") : "Setup Invalid · SL hit"
        else if L.hit == 0 and bar_index - L.bar > planMaxBars
            endState := 5
            result := "Stale · timed out"
        else if not activated
            k = L.hit
            while k < n
                if (d == 1 ? high >= array.get(L.tps, k) : low <= array.get(L.tps, k))
                    L.hit := k + 1
                    k += 1
                else
                    k := n
            if L.hit >= n
                endState := 3
                result := "TP" + str.tostring(n) + " ✓ · Complete"
            else if beMode != "Off" and not L.be and (L.hit >= 1 or (beMode == "After 1R or TP1" and (d == 1 ? high >= L.entry + L.R : low <= L.entry - L.R)))
                L.be := true
                L.sl := L.entry
    [endState, result, activated]

f_shEnd(int state, string result) =>
    if state == 3
        sh.nFull += 1
    if sh.hit >= 1
        sh.nWin += 1
    else if state == 4
        sh.nLoss += 1
    else
        sh.nExp += 1
    f_markTag(sh.bar, sh.dir, sh.grade, sh.hit, array.size(sh.tps), sh.entry, sh.R, sh.family, sh.model, sh.led, result, state, sh.why)
    sh.state := 0

f_shStart(int d, float entry, float sl, float R, array<float> tps, string grade, string model, string family, string led, bool liveNow, Fvg f, string why, float far, float zTop, float zBot, float buf) =>
    sh.state := liveNow ? 2 : 1
    sh.dir := d
    sh.entry := entry
    sh.sl := sl
    sh.R := R
    sh.far := far
    sh.zTop := zTop
    sh.zBot := zBot
    sh.buf := buf
    sh.touched := false
    sh.confirmN := 0
    sh.ceHit := false
    sh.tps := tps
    sh.hit := 0
    sh.bar := bar_index
    sh.grade := grade
    sh.model := model
    sh.family := family
    sh.led := led
    sh.be := false
    sh.fvg := f
    sh.why := why
    sh.lastVpBar := led == "VP-led" ? st.vpBar : sh.lastVpBar
    sh.lastBrkBar := model == "Breaker Retest" ? st.brkBar : sh.lastBrkBar
    sh.lastOteBar := model == "OTE Retest" ? st.swBar : sh.lastOteBar
    if not na(f)
        sh.lastFvgBar := f.barIdx
        sh.lastFvgTf := f.tf
    else
        sh.lastFvgBar := -1
        sh.lastFvgTf := ""
    sh.nPlans += 1

// Placebo control: same bar and direction, entry at the close, stop and TP1 at the same distances, no zone. One at a time.
f_ctStart(int d, float R, float tpDist) =>
    if ct.state == 0
        ct.state := 2
        ct.dir := d
        ct.entry := close
        ct.sl := d == 1 ? close - R : close + R
        ct.tps := array.from(d == 1 ? close + tpDist : close - tpDist)
        ct.hit := 0
        ct.bar := bar_index
        ct.R := R
        ct.be := false
        ct.touched := true
        ct.confirmN := 0
        ct.ceHit := false
        st.nCtrl += 1

f_planEnd(int state, string result) =>
    st.plState := state
    st.plEndBar := bar_index
    st.lastResult := result
    if state == 6
        // the replaced plan never had an outcome: it is not an idea for the stats or the per-killzone cap
        st.nPlans -= 1
        st.ideaCount := math.max(0, st.ideaCount - 1)
    if state != 6
        f_markIdea(state)
        if st.plHit >= 1
            st.nWin += 1
        else if state == 4
            st.nLoss += 1
            st.coolDir := st.plDir
            st.coolSwBar := st.swBar
            st.coolVpBar := st.vpBar
            st.swUsed := st.swDir == st.plDir ? true : st.swUsed
        else
            st.nExp += 1
    if state == 3
        st.nFull += 1
        f_planFreeze()
    else
        f_planClear()
    // a spent VP rotation must be re-earned; a price-action plan only resets the hold progress
    // (two plain ifs: Pine infers a function's return type from its last if/else, so the branches must not differ in type)
    if st.plLed == "VP-led"
        f_vpReset()
    if st.plLed != "VP-led"
        st.holdCount := 0
        st.holdExt := st.vpDir == 1 ? low : high
    if (state == 5 or state == 6) and not na(st.plFvg) and result != "Expired · stop swept before entry" and result != "Expired · full fill before entry"
        st.plFvg.used := false

f_planBe() =>
    if not na(st.lnSl)
        line.set_y1(st.lnSl, st.plSl)
        line.set_y2(st.lnSl, st.plSl)
    if not na(st.bxRisk)
        box.set_bgcolor(st.bxRisk, color.new(chart.fg_color, 90))

drawPlanNow = false
// a deeper print re-based the sweep, or the leg an OTE plan was measured from has extended: the pending plan is stale
if confirmed and st.plState == 1 and ((nz(st.rebaseBar, -1) == bar_index and st.plDir == st.swDir) or (st.plModel == "OTE Retest" and not na(st.plLegExt) and st.plLegExt != st.legExt))
    f_planEnd(5, nz(st.rebaseBar, -1) == bar_index and st.plDir == st.swDir ? "Expired · deeper sweep before entry" : "Expired · leg extended")
if confirmed and (st.plState == 1 or st.plState == 2)
    pl.state := st.plState
    pl.dir := st.plDir
    pl.entry := st.plEntry
    pl.sl := st.plSl
    pl.tps := st.plTps
    pl.hit := st.plHit
    pl.bar := st.plBar
    pl.R := st.plR
    pl.be := st.plBe
    pl.far := st.plFar
    pl.zTop := st.plZTop
    pl.zBot := st.plZBot
    pl.buf := st.plBuf
    pl.touched := st.plTouched
    pl.confirmN := st.plConfirmN
    pl.ceHit := st.plCeHit
    pl.fvg := st.plFvg
    beBefore = st.plBe
    [es, res, act] = f_lifeStep(pl, true)
    st.plState := pl.state
    st.plEntry := pl.entry
    st.plSl := pl.sl
    st.plHit := pl.hit
    st.plR := pl.R
    st.plBe := pl.be
    st.plTouched := pl.touched
    st.plConfirmN := pl.confirmN
    st.plCeHit := pl.ceHit
    if act
        drawPlanNow := true
        st.swUsed := st.swDir == st.plDir ? true : st.swUsed
        st.brkUsed := st.plModel == "Breaker Retest" ? true : st.brkUsed
        st.oteUsed := st.plModel == "OTE Retest" ? true : st.oteUsed
    if es != 0
        f_planEnd(es, res)
    else if st.plBe and not beBefore
        f_planBe()

if confirmed and st.plState == 3 and bar_index - st.plEndBar > resultBars and not na(st.lnEntry)
    f_planClear()

// ── Shadow idea: the same lifecycle as the live plan, without drawings, alerts or session counting ──
if confirmed and (sh.state == 1 or sh.state == 2)
    [es, res, act] = f_lifeStep(sh, true)
    if es != 0
        f_shEnd(es, res)
// ── Placebo control ──
if confirmed and ct.state == 2
    [es, res, act] = f_lifeStep(ct, false)
    if es != 0
        st.nCtrlWin += ct.hit >= 1 ? 1 : 0
        st.nCtrlLoss += es == 4 ? 1 : 0
        ct.state := 0

if confirmed and array.size(ideaMarkT) > 0
    f_pruneMarks()

// ───────────────────────────── Entry models → trade plan ─────────────────────────────
paDir  = (st.swDir == 1 or st.swDir == -1) and st.reactOK ? st.swDir : 0
extSw  = (st.swDir == 1 or st.swDir == -1) and st.swExternal
dirNow = paDir != 0 ? paDir : extSw ? st.swDir : st.vpDir != 0 ? st.vpDir : (st.swDir == 1 or st.swDir == -1) ? st.swDir : 0
ctxBar = paDir != 0 or extSw ? st.swBar : st.vpDir != 0 ? st.vpBar : st.swBar

f_fvgNear(Fvg f, int d) =>
    d == 1 ? f.top : f.bottom

f_fvgFar(Fvg f, int d) =>
    d == 1 ? f.bottom : f.top

// Retest zones arm a pending plan as soon as price is away from them (a resting limit at the near edge); nearest zone first.
f_pickFvgRetest(array<Fvg> arr, int d, int sinceBar) =>
    Fvg r = na
    best = float(na)
    for f in arr
        if f.state == 0 and f.dir == d and not f.used and f.barIdx >= sinceBar and bar_index > f.barIdx + 1 and f.top - f.bottom >= minTradeGapAtr * atr
            near = f_fvgNear(f, d)
            beyond = d == 1 ? close - near : near - close
            fresh = d == 1 ? f.minClose > f.bottom : f.maxClose < f.top
            dist = math.abs(close - near)
            if beyond >= 0.25 * atrRisk and fresh and (na(best) or dist < best)
                best := dist
                r := f
    r

f_pickIfvg(int d, bool wantClose, int sinceBar) =>
    Fvg r = na
    best = float(na)
    for f in fvgs
        if f.state == 1 and f.dir == -d and not f.used and f.invBar >= sinceBar and f.top - f.bottom >= minTradeGapAtr * atr
            if wantClose
                if f.invBar == bar_index
                    r := f
            else if f.invBar < bar_index
                near = f_fvgNear(f, d)
                beyond = d == 1 ? close - near : near - close
                dist = math.abs(close - near)
                if beyond >= 0.25 * atrRisk and (na(best) or dist < best)
                    best := dist
                    r := f
    r

f_entryFromFvg(Fvg f, int d) =>
    switch entryRefIn
        "50%"                => (f.top + f.bottom) / 2
        "Far Edge"           => f_fvgFar(f, d)
        "Confirmation Close" => close
        => f_fvgNear(f, d)

f_stackedVp(float entry) =>
    cnt = 0
    for role in vpRoles
        if f_roleShown(role)
            for lvl in vpLvls
                L = f_levelVal(role, lvl, false)
                if not na(L) and math.abs(L - entry) <= atr * 0.5
                    cnt += 1
    cnt >= 2

f_protectedPivot(int d, float entry) =>
    float r = na
    for p in pivs
        if d == 1 and not p.isHigh and p.price < entry and (na(r) or p.price > r)
            r := p.price
        if d == -1 and p.isHigh and p.price > entry and (na(r) or p.price < r)
            r := p.price
    r

// Structural stop ladder (checklist: below / above the rejection wick, 1–2 structure legs behind the entry, protected by
// internal liquidity): the sweep wick while it is within 'Max stop', else the nearest protected pivot between the entry
// and that wick, else the far edge of the zone. Anything tighter than 0.25 ATR is not a structure.
f_structStop(int d, float entry, float far) =>
    float r = na
    lim = maxSlAtr * atrRisk
    sw  = st.swDir == d ? st.swExt : float(na)
    piv = f_protectedPivot(d, entry)
    // re-sweep guard: an untaken level or pivot just beyond the wick is the next pool of the same sweep
    guard = resweepAtr * atrRisk
    deep = float(na)
    if not na(sw) and resweepMode != "Off"
        for s in sessions
            lvl = d == 1 ? s.lo : s.hi
            if s.done and (d == 1 ? not s.loTaken and lvl < sw and lvl >= sw - guard : not s.hiTaken and lvl > sw and lvl <= sw + guard)
                deep := na(deep) ? lvl : (d == 1 ? math.min(deep, lvl) : math.max(deep, lvl))
        for p in pivs
            if (d == 1 ? not p.isHigh and p.price < sw and p.price >= sw - guard : p.isHigh and p.price > sw and p.price <= sw + guard)
                deep := na(deep) ? p.price : (d == 1 ? math.min(deep, p.price) : math.max(deep, p.price))
    sw := na(deep) ? sw : resweepMode == "Extend" ? deep : float(na)
    st.resweepSkip := not na(deep) and resweepMode == "Skip"
    if st.resweepSkip
        r := float(na)      // Skip: the idea waits until the next pool is taken
    else if not na(sw) and math.abs(entry - sw) <= lim and math.abs(entry - sw) >= 0.5 * atrRisk
        r := sw
    else if not na(piv) and math.abs(entry - piv) <= lim and math.abs(entry - piv) >= 0.5 * atrRisk and (na(sw) or (d == 1 ? piv >= sw : piv <= sw))
        r := piv
    else if not na(far) and math.abs(entry - far) <= lim and math.abs(entry - far) >= 0.5 * atrRisk
        r := far
    r

f_candidates(int d, float entry) =>
    pool = array.new<float>()
    poolB = array.new<float>()
    for role in vpRoles
        if f_roleShown(role)
            for lvl in vpLvls
                L = f_levelVal(role, lvl, false)
                if not na(L) and (d == 1 ? L > entry : L < entry)
                    array.push(pool, L)
    for s in sessions
        if s.done
            if d == 1 and not s.hiTaken and s.hi > entry
                array.push(pool, s.hi)
            if d == -1 and not s.loTaken and s.lo < entry
                array.push(pool, s.lo)
    for p in pivs
        if d == 1 and p.isHigh and p.price > entry
            array.push(pool, p.price)
        if d == -1 and not p.isHigh and p.price < entry
            array.push(pool, p.price)
    for f in fvgs
        if f.state == 0 and f.dir == -d
            if d == 1 and f.bottom > entry
                array.push(poolB, f.bottom)
            if d == -1 and f.top < entry
                array.push(poolB, f.top)
    [pool, poolB]

f_tpOk(array<float> tps, float entry, float R, float p) =>
    ok = math.abs(p - entry) >= minTp1R * R and math.abs(p - entry) <= maxTpAtr * atr and array.size(tps) < 3
    for t in tps
        if math.abs(math.abs(t - entry) - math.abs(p - entry)) < tpSepR * R
            ok := false
    ok

// Profile hierarchy keeps its slots, the liquidity/VP pool fills the rest nearest-first,
// lower-timeframe FVG edges only fill what is still empty; the final list is nearest → farthest.
f_pickTargets(int d, float entry, float R, array<float> pri, array<float> poolA, array<float> poolB) =>
    tps = array.new<float>()
    if d == 1
        array.sort(poolA, order.ascending)
        array.sort(poolB, order.ascending)
    else
        array.sort(poolA, order.descending)
        array.sort(poolB, order.descending)
    for p in pri
        if f_tpOk(tps, entry, R, p)
            array.push(tps, p)
    for p in poolA
        if f_tpOk(tps, entry, R, p)
            array.push(tps, p)
    nLiq = array.size(tps)
    for p in poolB
        if f_tpOk(tps, entry, R, p)
            array.push(tps, p)
    if nLiq == 0 and needLiqTp
        array.clear(tps)
    if d == 1
        array.sort(tps, order.ascending)
    else
        array.sort(tps, order.descending)
    tps

f_grade(int d, string led, float entry) =>
    vpAligned = led == "VP-led" or st.vpDir == d
    paAligned = st.swDir == d and st.reactOK and st.reactDir == d and (not needMss or st.mssOK)
    conf = 0
    conf += (st.swDir == d and st.swHtf != "") or f_htfAligned(d) != "" ? 1 : 0
    conf += smtFresh and st.smtDir == d ? 1 : 0
    conf += st.swDir == d and st.swExternal and st.reactOK ? 1 : 0
    conf += f_stackedVp(entry) ? 1 : 0
    vpAligned and paAligned ? (conf >= 2 ? "A+" : "A") : "B"

// checklist steps 2 / 3: an HTF FVG at the sweep or the entry, or a fresh SMT, in the idea's direction
f_optConf(int d) =>
    (st.swDir == d and st.swHtf != "") or f_htfAligned(d) != "" or (smtFresh and st.smtDir == d)

f_addPt(int pts, string txt, bool ok, string name) =>
    [pts + (ok ? 1 : 0), txt + (ok ? "✓ " : "☐ ") + name + "   "]

// Confluence score, 10 points. zTop / zBot = the entry zone (na when there is none yet).
f_score(int d, string led, float entry, float zTop, float zBot, Fvg zoneF) =>
    leg = st.swDir == d and not na(st.legExt) ? (d == 1 ? st.legExt - st.swExt : st.swExt - st.legExt) : float(na)
    swOK = st.swDir == d
    [p1, t1] = f_addPt(0, "", swOK and st.swExternal, (qualityFloor != "Off" ? "gate ✓ " : "") + "External sweep")
    [p2, t2] = f_addPt(p1, t1, swOK and st.mssOK, (needMss ? "gate ✓ " : "") + "Shift (" + (st.mssVia == "" ? "CISD / MSS" : st.mssVia) + ")")
    [p3, t3] = f_addPt(p2, t2, not na(leg) and leg >= 3 * atr, "Leg ≥ 3 ATR")
    [p4, t4] = f_addPt(p3, t3, (swOK and st.swHtf != "") or f_htfAligned(d) != "" or dayBias == d, "HTF FVG / daily bias")
    [p5, t5] = f_addPt(p4, t4, smtFresh and st.smtDir == d, "SMT")
    [p6, t6] = f_addPt(p5, t5, led == "VP-led" or st.vpDir == d, "VP aligned")
    zoneWin = not na(zoneF) ? ((zoneF.inKz or zoneF.inSb) and zoneF.barIdx >= st.swBar) : swOK and st.mssOK ? st.mssInWin : (inKzAm or inKzPm or inSbAm or inSbPm)
    [p7, t7] = f_addPt(p6, t6, zoneWin, "Time (zone formed in a window)")
    [p8, t8] = f_addPt(p7, t7, not na(leg) and not na(entry) and (d == 1 ? entry <= st.legExt - 0.5 * leg : entry >= st.legExt + 0.5 * leg), d == 1 ? "Discount entry" : "Premium entry")
    [p9, t9] = f_addPt(p8, t8, swOK and st.brkOK and not na(zTop) and not (zTop == st.brkTop and zBot == st.brkBot) and zTop > st.brkBot and zBot < st.brkTop, "Unicorn (breaker overlap)")
    [p10, t10] = f_addPt(p9, t9, (not na(entry) and f_stackedVp(entry)) or (st.vpDir == d and st.vpKind == "Rotation" and st.vpOpenOut == -d), "Value structure")
    [p11, t11] = f_addPt(p10, t10, (st.trendDir != 0 and st.trendDir == d) or (st.trendDir == 0 and not na(vw) and not na(entry) and (d == 1 ? entry >= vw : entry <= vw)), "Day type / VWAP aligned")
    [p11, t11]

// points the active gates already enforce are shown as 'gate ✓' and do not count: A always means independent confluences
freePts = (qualityFloor != "Off" ? 1 : 0) + (needMss ? 1 : 0)
f_scoreGrade(int s) =>
    s - freePts >= scoreAp ? "A+" : s - freePts >= scoreA ? "A" : "B"

f_familyShort(string fam) =>
    fam == "Value Rotation" ? "Rotation" : fam == "Value Continuation" ? "Continuation" : "Inversion"

// The plan on the chart: a pending plan is a dotted outline of its zone; an active plan is the entry line with a risk box
// (entry ↔ stop) and a reward box (entry ↔ TP1), TP2 / TP3 dotted. Every label comes from the right-edge registry.
f_planDraw() =>
    f_planClear()
    if usePlanDraw
        c = st.plDir == 1 ? bullCol : bearCol
        grey = color.new(chart.fg_color, 45)
        x1 = f_x(st.plBar)
        x2 = bar_index + 5
        if st.plState == 1
            if not na(st.plZTop)
                st.bxZone := box.new(x1, st.plZTop, x2, st.plZBot, border_color = color.new(c, 50), border_style = line.style_dotted, border_width = 1, bgcolor = color.new(c, 100))
        else
            st.lnEntry := line.new(x1, st.plEntry, x2, st.plEntry, color = c, width = 2)
            st.lnSl := line.new(x1, st.plSl, x2, st.plSl, color = color.new(chart.fg_color, 35), style = line.style_dotted)
            if showPlan == "Position boxes" and array.size(st.plTps) > 0
                tp1 = array.get(st.plTps, 0)
                st.bxRisk := box.new(x1, math.max(st.plEntry, st.plSl), x2, math.min(st.plEntry, st.plSl), bgcolor = color.new(bearCol, 85), border_color = color.new(bearCol, 100))
                st.bxReward := box.new(x1, math.max(st.plEntry, tp1), x2, math.min(st.plEntry, tp1), bgcolor = color.new(bullCol, 88), border_color = color.new(bullCol, 100))
            for [i, tp] in st.plTps
                if i > 0 or showPlan == "Lines"
                    array.push(st.lnTps, line.new(x1, tp, x2, tp, color = grey, style = line.style_dotted))
    // plain final statement: the if / else above has branches of different types (box vs. loop), which Pine would otherwise try to unify (CE10235)
    usePlanDraw

// plan tabs for the right-edge column (last bar)
f_planLabels() =>
    if usePlanDraw and (st.plState == 1 or st.plState == 2 or (st.plState == 3 and bar_index - st.plEndBar <= resultBars))
        c = st.plDir == 1 ? bullCol : bearCol
        grey = color.new(chart.fg_color, 45)
        f_edgePush(st.plEntry, (st.plState == 1 ? "PENDING " : "") + st.plGrade + (st.plDir == 1 ? " LONG · " : " SHORT · ") + st.plModel, c, 1)
        if st.plState != 1
            f_edgePush(st.plSl, st.plBe ? "BE" : "SL", color.new(chart.fg_color, 35), 1)
            for [i, tp] in st.plTps
                f_edgePush(tp, "TP" + str.tostring(i + 1) + (i < st.plHit ? " ✓" : "") + " " + str.tostring(math.abs(tp - st.plEntry) / st.plR, "#.#") + "R", grey, 1)

f_gradeRank(string g) =>
    g == "A+" ? 3 : g == "A" ? 2 : 1

// HTF bias: direction of the newest active 15m+ mapped gap, and / or price location against the last completed value area (OV, else PD).
f_mapNewest(array<Fvg> arr, string tf, bool enabled, int d0, int b0) =>
    dd = d0
    bb = b0
    if enabled and useHtf and timeframe.in_seconds(tf) >= 900
        for f in arr
            if f.state == 0 and f.barIdx > bb
                bb := f.barIdx
                dd := f.dir
    [dd, bb]

f_mapBias() =>
    [d1, b1] = f_mapNewest(htf1, htfTf1, htfOn1, 0, -1)
    [d2, b2] = f_mapNewest(htf2, htfTf2, htfOn2, d1, b1)
    [d3, b3] = f_mapNewest(htf3, htfTf3, htfOn3, d2, b2)
    [d4, b4] = f_mapNewest(htf4, htfTf4, htfOn4, d3, b3)
    [d5, b5] = f_mapNewest(htf5, htfTf5, htfOn5, d4, b4)
    [d6, b6] = f_mapNewest(htf6, htfTf6, htfOn6, d5, b5)
    d6

f_valueBias() =>
    role = na(f_levelVal("OV", "VAH", false)) ? "PD" : "OV"
    vh = f_levelVal(role, "VAH", false)
    vl = f_levelVal(role, "VAL", false)
    na(vh) ? 0 : close > vh ? 1 : close < vl ? -1 : 0

f_biasOK(int d) =>
    // an external sweep that already produced the shift overrides the 15m+ map: the newest 15m gap is usually the one that drove price into the liquidity
    override = st.swDir == d and st.swExternal and st.mssOK
    mapD = override ? 0 : (htfBias == "15m+ FVG map" or htfBias == "Map + Value") ? f_mapBias() : 0
    valD = (htfBias == "Value location (OV / PD)" or htfBias == "Map + Value" or htfBias == "Value + Daily") ? f_valueBias() : 0
    dayD = (htfBias == "Daily bias" or htfBias == "Value + Daily") ? dayBias : 0
    pdS = array.get(sessions, array.size(sessions) - 1)
    pdBlock = dayD != 0 and pdS.done and ((d == -1 and pdS.hiClosed and close > pdS.hi) or (d == 1 and pdS.loClosed and close < pdS.lo))
    (mapD == 0 or mapD == d) and (valD == 0 or valD == d) and (dayD == 0 or dayD == d) and not pdBlock

quietNow = (openQuietMin > 0 and not na(sesOpenTime) and time - sesOpenTime < openQuietMin * 60000) or (reviewQuiet > 0 and not na(twoSidedBar) and bar_index - twoSidedBar <= reviewQuiet) or (mocQuiet and inMoc)
windowOK = (tradeWindow == "Any" or (tradeWindow == "Killzones" and (inKzAm or inKzPm or inLate)) or (tradeWindow == "Silver Bullet (10–11 · 14–15)" and (inSbAm or inSbPm)) or (tradeWindow == "NY AM + PM" and (array.get(inSesArr, 2) or array.get(inSesArr, 3))) or (tradeWindow == "NY AM only" and array.get(inSesArr, 2))) and not quietNow
if drawPlanNow
    f_planDraw()

cooled = coolStop and dirNow == nz(st.coolDir) and ((st.swDir == dirNow and st.swBar == nz(st.coolSwBar, -1)) or (st.vpDir == dirNow and st.vpBar == nz(st.coolVpBar, -1)))
newPlan = false
// a plan may be saved on this bar (save slot); otherwise a complete candidate can still be followed as a shadow idea
saveSlot   = windowOK and not cooled and st.plState != 2 and (st.plState != 1 or replacePending) and (nz(st.plEndBar, -1) != bar_index or (st.plState == 4 and st.plDir != dirNow))
shadowSlot = shadowMode != "Off" and useIdeaMk and sh.state == 0

if confirmed and (saveSlot or shadowSlot) and st.swDir != 2 and (dirNow == 1 or dirNow == -1)
    d = dirNow
    string model = ""
    string led = ""
    string family = ""
    float entry = na
    float structStop = na
    string basis = ""
    Fvg usedFvg = na
    bool liveNow = false
    float farEdge = na        // far side of the entry zone (last rung of the structural stop ladder)
    float zTop = na           // entry zone for the Unicorn point
    float zBot = na
    leg = st.swDir == d and not na(st.legExt) ? (d == 1 ? st.legExt - st.swExt : st.swExt - st.legExt) : float(na)
    legOK = st.swDir != d or na(st.legExt) or leg >= legMinAtr * atr
    paCtx = st.swDir == d and st.reactOK and (not needMss or st.mssOK) and legOK and (not oneIdeaPerSweep or not st.swUsed)
    // Price-action models (need a sweep + reaction (+ structure shift), or an aligned VP context)
    if paCtx or st.vpDir == d
        since3 = math.max(ctxBar, bar_index - zoneMaxAge)
        f1 = f_pickIfvg(d, false, math.max(st.swBar, bar_index - zoneMaxAge))
        f2 = f_pickIfvg(d, true, st.swBar)
        f3 = f_pickFvgRetest(fvgs, d, since3)
        if na(f3) and entryGaps == "Chart + 3m / 5m map" and useHtf
            // a mapped gap is anchored at its own bar's open, which may precede the sweep candle by up to one HTF bar
            if htfOn1 and timeframe.in_seconds(htfTf1) > chartSec and timeframe.in_seconds(htfTf1) < 900
                f3 := f_pickFvgRetest(htf1, d, math.max(ctxBar - math.round(timeframe.in_seconds(htfTf1) / chartSec), bar_index - zoneMaxAge))
            if na(f3) and htfOn2 and timeframe.in_seconds(htfTf2) > chartSec and timeframe.in_seconds(htfTf2) < 900
                f3 := f_pickFvgRetest(htf2, d, math.max(ctxBar - math.round(timeframe.in_seconds(htfTf2) / chartSec), bar_index - zoneMaxAge))
        if not na(f1) and paCtx
            model := "IFVG Retest"
            usedFvg := f1
        else if not na(f2) and paCtx
            model := "IFVG Close"
            usedFvg := f2
        else if not na(f3) and (paCtx or (st.swDir != d and st.reactOK and st.reactDir == d and legOK))
            model := "FVG Retest"
            usedFvg := f3
        if model != ""
            led := "Price-action-led"
            // close-through confirmation activates at the confirming close; retest models use the entry reference
            ifvgPend = model == "IFVG Close" and ifvgCloseMode == "Pending at the IFVG (retest)"
            entry := model == "IFVG Close" and not ifvgPend ? close : f_entryFromFvg(usedFvg, d)
            farEdge := f_fvgFar(usedFvg, d)
            zTop := usedFvg.top
            zBot := usedFvg.bottom
            basis := usedFvg.tf + " FVG"
            liveNow := not ifvgPend and (model == "IFVG Close" or entryRefIn == "Confirmation Close")
        // Breaker Retest: the failed order block at the broken swing is retested and price closes back beyond it
        if model == "" and useBreaker and paCtx and st.brkOK and not st.brkUsed and bar_index > st.mssBar and (d == 1 ? close > st.brkTop + 0.25 * atrRisk : close < st.brkBot - 0.25 * atrRisk)
            near = d == 1 ? st.brkTop : st.brkBot
            farB = d == 1 ? st.brkBot : st.brkTop
            model := "Breaker Retest"
            led := "Price-action-led"
            entry := entryRefIn == "50%" ? (st.brkTop + st.brkBot) / 2 : entryRefIn == "Far Edge" ? farB : entryRefIn == "Confirmation Close" ? close : near
            farEdge := farB
            zTop := st.brkTop
            zBot := st.brkBot
            basis := "Breaker"
            liveNow := entryRefIn == "Confirmation Close"
        // OTE Retest: the pullback reaches the 62–79 % retrace of the displacement leg and holds
        if model == "" and useOte and paCtx and not st.oteUsed and not na(leg) and leg > 0 and bar_index > st.legExtBar
            o62 = d == 1 ? st.legExt - 0.62 * leg : st.legExt + 0.62 * leg
            o705 = d == 1 ? st.legExt - 0.705 * leg : st.legExt + 0.705 * leg
            o79 = d == 1 ? st.legExt - 0.79 * leg : st.legExt + 0.79 * leg
            // arm once the pullback has retraced at least 38.2 % of the leg and still sits above (below) the band
            hitO = d == 1 ? (close <= st.legExt - 0.382 * leg and close > o62) : (close >= st.legExt + 0.382 * leg and close < o62)
            if hitO
                model := "OTE Retest"
                led := "Price-action-led"
                entry := o705
                farEdge := o79
                zTop := d == 1 ? o62 : o79
                zBot := d == 1 ? o79 : o62
                basis := "OTE 70.5 %"
                liveNow := false
        if model != ""
            ifvgPend = model == "IFVG Close" and ifvgCloseMode == "Pending at the IFVG (retest)"
            structStop := switch stopRefIn
                "Structure (sweep wick → pivot → gap)" => f_structStop(d, entry, farEdge)
                "Trade Idea High/Low" => st.swDir == d ? st.swExt : farEdge
                "Latest High/Low"     => st.reactOK and st.reactDir == d ? st.reactExt : farEdge
                "Internal High/Low"   => f_protectedPivot(d, entry)
                "ATR Stop"            => float(na)
                => farEdge
            if (model != "IFVG Close" or ifvgPend) and not na(structStop)
                structStop := d == 1 ? math.min(structStop, low) : math.max(structStop, high)
            family := model != "FVG Retest" or st.vpDir != d ? "Liquidity Inversion" : st.vpKind == "Rotation" ? "Value Rotation" : "Value Continuation"
    // VP-led models (Value Rotation)
    if model == "" and st.vpModel != "" and st.vpModelBar == bar_index and st.vpDir == d
        model := st.vpModel
        led := "VP-led"
        family := "Value Rotation"
        L0 = f_levelVal(st.vpRole, st.vpLevel, false)
        entry := model == "VP Hold" ? close : L0
        structStop := d == 1 ? math.min(st.vpModelExt, L0) : math.max(st.vpModelExt, L0)
        basis := st.vpRole + " " + st.vpLevel
        liveNow := true
    biasOK = model == "" or na(entry) or f_biasOK(d)
    if model != "" and not na(entry)
        // no structure within reach = no idea (unless the ATR stop is allowed): a stop nothing protects is the stop that gets hit
        buf0 = math.max(slBufTicks * tick, math.max(slBufAtr * atrRisk, slBufLegPct / 100 * nz(leg, 0)))
        sl0 = d == 1 ? structStop - buf0 : structStop + buf0
        noStruct = na(sl0) or (d == 1 ? sl0 >= entry - tick : sl0 <= entry + tick) or math.abs(entry - sl0) < 0.5 * atrRisk or math.abs(entry - sl0) > maxSlAtr * atrRisk + buf0
        if noStruct and not atrFallback and stopRefIn != "ATR Stop"
            if saveSlot
                st.lastNote := st.resweepSkip ? "Waiting · next pool within " + str.tostring(resweepAtr) + " ATR · " + model : "Waiting · no structural stop within " + str.tostring(maxSlAtr) + " ATR · " + model
                st.lastNoteBar := bar_index
                if led == "VP-led"
                    st.vpModel := ""
                    st.holdCount := 0
            model := ""
    if model != "" and not na(entry)
        buf = math.max(slBufTicks * tick, math.max(slBufAtr * atrRisk, slBufLegPct / 100 * nz(leg, 0)))
        sl = d == 1 ? structStop - buf : structStop + buf
        atrStop = na(sl) or (d == 1 ? sl >= entry - tick : sl <= entry + tick) or math.abs(entry - sl) < 0.5 * atrRisk or math.abs(entry - sl) > maxSlAtr * atrRisk + buf
        if atrStop
            sl := d == 1 ? entry - slAtrMult * atr : entry + slAtrMult * atr
        R = math.abs(entry - sl)
        pri = array.new<float>()
        if family == "Value Rotation" and st.vpDir == d
            pocL = f_levelVal(st.vpRole, "POC", false)
            farL = f_levelVal(st.vpRole, d == 1 ? "VAH" : "VAL", false)
            if not na(pocL) and (d == 1 ? pocL > entry : pocL < entry)
                array.push(pri, pocL)
            if not na(farL) and (d == 1 ? farL > entry : farL < entry)
                array.push(pri, farL)
        [poolA, poolB] = f_candidates(d, entry)
        tps = f_pickTargets(d, entry, R, pri, poolA, poolB)
        while atrStop and array.size(tps) > 0 and math.abs(array.get(tps, 0) - entry) < atrMinTp1R * R
            array.shift(tps)
        [scoreNow, ptsNow] = f_score(d, led, entry, zTop, zBot, usedFvg)
        gradeNow = gradeMode == "Confluence score" ? f_scoreGrade(scoreNow) : f_grade(d, led, entry)
        floorOK = qualityFloor == "Off" or (st.swDir == d and st.swExternal) or (qualityFloor == "External sweep or VP context" and st.vpDir == d) or (qualityFloor == "External sweep (VP-led ideas pass)" and led == "VP-led")
        gradeFloor = isPlaybook ? "B" : minGrade   // the Playbook view has no VP, so every idea is B there
        gradeOK = f_gradeRank(gradeNow) >= f_gradeRank(gradeFloor)
        capKey = tradeWindow == "Any" ? fvgSes : kzSeq      // one idea per killzone, or per VP session when every hour trades
        if st.ideaSes != capKey
            st.ideaSes := capKey
            st.ideaCount := 0
        cntNow = st.ideaCount - (st.plState == 1 ? 1 : 0)      // a pending plan this candidate may replace frees its own slot
        capOK = sesIdeaCap == 0 or cntNow < sesIdeaCap or (apExtra and gradeNow == "A+" and cntNow < sesIdeaCap + 1)
        optOK = not needOpt or f_optConf(d)
        lateOK = not inLate or family == "Value Continuation" or (st.trendDir != 0 and st.trendDir == d)
        trendOK = trendLock != "Block reversals" or family != "Liquidity Inversion" or st.trendDir == 0 or st.trendDir == d
        replaceOK = st.plState != 1 or scoreNow > st.plScore
        canSave = saveSlot and biasOK and gradeOK and floorOK and optOK and capOK and lateOK and trendOK and replaceOK and array.size(tps) > 0
        if not canSave
            if saveSlot and st.plState != 1
                st.lastNote := array.size(tps) == 0 ? "Waiting for targets · " + model : not biasOK ? "Filtered · against HTF bias · " + htfBias : not floorOK ? "Filtered · quality floor" : not gradeOK ? "Filtered · grade " + gradeNow + " below " + gradeFloor : not optOK ? "Filtered · no HTF FVG / SMT confluence" : not lateOK ? "Filtered · late-session reversal" : not trendOK ? "Filtered · trend day " + (st.trendDir == 1 ? "↑" : "↓") : "Filtered · " + str.tostring(sesIdeaCap) + " idea" + (sesIdeaCap == 1 ? "" : "s") + " per " + (tradeWindow == "Any" ? "session" : "killzone") + (apExtra ? " (A+ may add one)" : "")
                st.lastNoteBar := bar_index
                if led == "VP-led"
                    st.vpModel := ""
                    st.holdCount := 0
            // follow the refused setup as a shadow idea (once per zone / level) so its outcome can be tagged and counted
            dupShadow = false
            if not na(usedFvg)
                dupShadow := usedFvg.barIdx == sh.lastFvgBar and usedFvg.tf == sh.lastFvgTf
            else
                dupShadow := (st.plState == 1 and st.plModel == model) or (model == "Breaker Retest" ? st.brkBar == sh.lastBrkBar : model == "OTE Retest" ? st.swBar == sh.lastOteBar : st.vpBar == sh.lastVpBar)
            if shadowSlot and array.size(tps) > 0 and not dupShadow and (shadowMode == "All grades" or gradeOK)
                why = not saveSlot or not replaceOK ? (st.plState == 1 or st.plState == 2 ? "a plan was already live" : not windowOK ? "outside the trading window or in a quiet period" : cooled ? "cooldown after a stop-out" : "same bar as the last result") : not biasOK ? "against the HTF bias (" + htfBias + ")" : not floorOK ? "quality floor (no external sweep)" : not gradeOK ? "grade " + gradeNow + " below " + gradeFloor : not optOK ? "no HTF FVG / SMT confluence" : not lateOK ? "late-session reversal" : not trendOK ? "trend day" : "ideas-per-killzone cap"
                f_shStart(d, entry, sl, R, tps, gradeNow, model, family, led, liveNow, usedFvg, why, farEdge, zTop, zBot, buf)
                f_ctStart(d, R, math.abs(array.get(tps, 0) - entry))
        else
            // a saved plan on the zone a shadow was following makes the shadow redundant
            if sh.state != 0 and not na(usedFvg) and not na(sh.fvg) and sh.fvg.barIdx == usedFvg.barIdx and sh.fvg.tf == usedFvg.tf
                sh.state := 0
            if st.plState == 1
                f_planEnd(6, "Replaced by a stronger setup")
            st.plState := liveNow ? 2 : 1
            st.swUsed := liveNow and st.swDir == d ? true : st.swUsed
            st.plDir := d
            st.plEntry := entry
            st.plSl := sl
            st.plBe := false
            st.plR := R
            st.plFar := farEdge
            st.plZTop := zTop
            st.plZBot := zBot
            st.plBuf := buf
            st.plTouched := false
            st.plConfirmN := 0
            st.plCeHit := false
            st.plLegExt := st.legExt
            f_ctStart(d, R, math.abs(array.get(tps, 0) - entry))
            st.plTps := tps
            st.plHit := 0
            st.plBar := bar_index
            st.ideaCount += 1
            st.plGrade := gradeNow
            st.plScore := scoreNow
            st.plPts := ptsNow
            st.brkUsed := liveNow and model == "Breaker Retest" ? true : st.brkUsed
            st.nPlans += 1
            st.plModel := model
            st.plFamily := family
            st.plLed := led
            st.plVpBasis := led == "VP-led" ? basis + " · Entry basis" : st.vpDir == d ? st.vpRole + " " + st.vpLevel + " · Same direction" : vpLocation
            st.lastResult := ""
            st.lastNote := ""
            st.lastModel := model
            st.lastModelLed := led
            st.lastModelBar := bar_index
            st.plFvg := usedFvg
            if not na(usedFvg)
                usedFvg.used := model != "IFVG Close" or ifvgCloseMode == "Pending at the IFVG (retest)"   // a zone with a pending plan is taken; the close entry leaves it for a later IFVG Retest
                usedFvg.traded := true
            if led == "VP-led"
                st.vpModel := ""
                st.holdCount := 0
            newPlan := true
            f_planDraw()

if confirmed and (st.plState == 1 or st.plState == 2)
    x2 = bar_index + 5
    if not na(st.lnEntry)
        line.set_x2(st.lnEntry, x2)
        line.set_x2(st.lnSl, x2)
        for ln in st.lnTps
            line.set_x2(ln, x2)
    if not na(st.bxRisk)
        box.set_right(st.bxRisk, x2)
        box.set_right(st.bxReward, x2)
    if not na(st.bxZone)
        box.set_right(st.bxZone, x2)

// ───────────────────────────── Drawing: VP levels, histograms, HTF placement ─────────────────────────────
var array<line>  vpLines  = array.new<line>()
var array<label> vpLbls   = array.new<label>()

f_roleStyle(string role) =>
    role == "DEV" ? line.style_solid : role == "OV" ? line.style_dashed : line.style_dotted

f_roleDrawn(string role) =>
    role == "DEV" or (role == "OV" and vpDrawIn != "DEV only") or (role == "PD" and (vpDrawIn == "DEV + OV + PD" or vpDrawIn == "All shown")) or (role == "PW" and vpDrawIn == "All shown")

f_drawVpLevels() =>
    for ln in vpLines
        line.delete(ln)
    array.clear(vpLines)
    if useVp
        x1 = f_x(bar_index - 50)
        if not na(dev)
            x1 := f_x(math.max(dev.startBar, bar_index - levelLookback))
        x2 = bar_index + 5
        for role in vpRoles
            if f_roleShown(role) and f_roleDrawn(role) and not (isFocus and role != "DEV")
                for lvl in vpLvls
                    L = f_levelVal(role, lvl, true)
                    if not na(L) and math.abs(L - close) <= 8 * atr
                        isPoc = lvl == "POC"
                        c = role == "DEV" ? (isPoc ? color.new(chart.fg_color, 20) : color.new(levelCol, f_alpha("live"))) : color.new(isPoc ? pocCol : levelCol, f_alpha("untaken"))
                        array.push(vpLines, line.new(x1, L, x2, L, color = c, style = role == "DEV" and not isPoc ? line.style_dashed : f_roleStyle(role), width = role == "DEV" and isPoc ? 2 : 1))
                        if useVpLabels and (role == "DEV" or math.abs(L - close) <= 1.5 * atr)
                            f_edgePush(L, lvl + (role == "DEV" ? "" : " " + role) + (role == "DEV" and not devEligible ? " *" : "") + (vpPrices ? " " + f_price(L) : ""), c, role == "DEV" ? 4 : 6)

f_placeRight(array<Fvg> arr) =>
    for f in arr
        if f.state == 0 and f.rightSide
            xl = bar_index + math.min(htfOffset, 499)
            xr = bar_index + math.min(htfOffset + htfWidth, 499)
            box.set_left(f.bx, xl)
            box.set_right(f.bx, xr)
            box.set_extend(f.bx, extend.none)
            if not na(f.ce)
                line.set_x1(f.ce, xl)
                line.set_x2(f.ce, xr)
                line.set_extend(f.ce, extend.none)

// Linked LTF promotion: a lower-timeframe gap covered by an active same-direction gap of the next ladder step is hidden.
f_coveredBy(Fvg f, array<Fvg> higher) =>
    r = false
    for g in higher
        if g.state == 0 and g.dir == f.dir and f.top > g.bottom and f.bottom < g.top
            r := true
    r

f_isPlanGap(Fvg f) =>
    r = false
    if not na(st.plFvg)
        r := st.plFvg.barIdx == f.barIdx and st.plFvg.tf == f.tf
    r

// Visibility pass (last bar). Small-timeframe gaps (chart TF, 3m, 5m) are shown only while they matter and trail price
// only then; gaps that served a past idea stay as short blocks; everything else is hidden. 15m+ gaps keep long blocks,
// dimmed when price is far. 'on' hides a gap covered by an active same-direction gap of the next ladder slot.
f_gapVis(array<Fvg> arr, array<Fvg> higher, bool on, bool ltf, float nearMult) =>
    plLive = st.plState == 1 or st.plState == 2
    swLive = st.swDir == 1 or st.swDir == -1
    for f in arr
        if f.state != 2
            band = atr * nearMult
            near = low <= f.top + band and high >= f.bottom - band
            covered = f.state == 0 and on and f_coveredBy(f, higher)
            planGap = plLive and f_isPlanGap(f)
            inIdea = dirNow != 0 and ((f.state == 0 and f.dir == dirNow and f.barIdx >= ctxBar) or (f.state == 1 and f.dir == -dirNow and swLive and f.invBar >= st.swBar))
            young = bar_index - f.barIdx <= ltfShowBars
            respected = f.resp >= 1
            freshR = inIdea and (ltf ? (young or (f.state == 1 and bar_index - f.invBar <= ltfShowBars)) : f.ses == fvgSes)
            keyR = planGap or respected or freshR
            live = gapShow == "Respected only" ? keyR : (not ltf or planGap or inIdea or young)
            show = not covered and (gapShow == "All" ? true : gapShow == "Respected only" ? keyR : (ltf ? (live or f.traded) : (f.ses == fvgSes or near)))
            show := show and (not isFocus or planGap or inIdea)
            rank = 0
            for g in arr
                if g.state == 0 and g.barIdx > f.barIdx
                    rank += 1
            fill = show and (ltf or rank < htfShowLast or near or planGap)
            baseTxt = f.state == 1 ? f.tf + " IFVG" : fvgLblMode == "None" or (fvgLblMode == "15m+ and IFVG only" and ltf) ? "" : f.tf + (fvgLblMode == "{tf} FVG" ? " FVG" : "")
            box.set_text(f.bx, baseTxt + (respected ? (baseTxt == "" ? "✓" : " ✓") : ""))
            if not f.rightSide
                xr = live ? bar_index + 5 : f_x(math.min(f.barIdx + ltfShowBars, bar_index))
                box.set_right(f.bx, xr)
                if not na(f.ce)
                    line.set_x2(f.ce, xr)
            bg0 = f.state == 1 ? ifvgCol : (f.dir == 1 ? fvgBullCol : fvgBearCol)
            bg = ltf ? bg0 : color.new(bg0, math.min(100, int(color.t(bg0)) + 2))
            zc = (f.state == 1 ? -f.dir : f.dir) == 1 ? bullCol : bearCol
            box.set_bgcolor(f.bx, fill ? bg : color.new(bg, 100))
            box.set_border_color(f.bx, planGap ? color.new(zc, 0) : show and not ltf ? color.new(zc, 60) : color.new(bg, 100))
            box.set_text_color(f.bx, show ? color.new((f.state == 1 ? -f.dir : f.dir) == 1 ? bullCol : bearCol, 15) : color.new(color.white, 100))
            if not na(f.ce)
                line.set_color(f.ce, show ? color.new(f.dir == 1 ? bullCol : bearCol, 50) : color.new(color.white, 100))

f_anySlot(string tf, bool on) =>
    on and useHtf and timeframe.in_seconds(tf) > chartSec

var array<line> eqLines = array.new<line>()
var line cisdLn = na

f_slotLtf(string tf) =>
    timeframe.in_seconds(tf) < 900

f_ladderSlot(string tf, bool on) =>
    sec = timeframe.in_seconds(tf)
    on and useHtf and sec > chartSec and sec <= 900

// Full NY always shares its extremes with NY AM / Lunch / PM: hide its label when another shown session already labels that price.
// Heavy redraw on the confirmed (committed) update of the last bar. During the first realtime bar after load it also runs on
// every tick: `heavyDrawn` is a plain var, so it is rolled back to false before each tick until a committed draw exists, and
// that is required – drawings made on an uncommitted tick are rolled back too, so a varip flag would leave the chart empty.
var bool heavyDrawn = false
heavyDraw = barstate.islast and (confirmed or not heavyDrawn)
var box brkBox = na
var box oteBox = na
if heavyDraw
    heavyDrawn := true
    box.delete(brkBox)
    box.delete(oteBox)
    f_drawVpLevels()
    if showBreaker and useBreaker and useFvg and st.brkOK and not st.brkUsed and (st.swDir == 1 or st.swDir == -1) and (not isLean or st.plState == 1 or st.plState == 2)
        brkC = color.new(#f1c40f, 0)
        brkBox := box.new(f_x(st.brkBar), st.brkTop, bar_index + 5, st.brkBot, border_color = color.new(brkC, 40), border_width = 1, border_style = line.style_dashed, bgcolor = color.new(brkC, 94), text = "BRK", text_size = lblSz, text_color = color.new(brkC, 15), text_halign = text.align_left, text_valign = text.align_center)
    legH = st.swDir == 1 ? st.legExt - st.swExt : st.swExt - st.legExt
    if useOte and useFvg and (st.swDir == 1 or st.swDir == -1) and st.reactOK and not st.oteUsed and not na(legH) and legH >= legMinAtr * atr and not isLean
        oteC = st.swDir == 1 ? bullCol : bearCol
        o62h = st.swDir == 1 ? st.legExt - 0.62 * legH : st.legExt + 0.79 * legH
        o79h = st.swDir == 1 ? st.legExt - 0.79 * legH : st.legExt + 0.62 * legH
        oteBox := box.new(f_x(st.swBar), o62h, bar_index + 5, o79h, border_color = color.new(oteC, 50), border_width = 1, border_style = line.style_dotted, bgcolor = color.new(oteC, 100), text = "OTE", text_size = lblSz, text_color = color.new(oteC, 30), text_halign = text.align_left, text_valign = text.align_center)
    if useHist and not na(dev)
        hw = f_histW(dev.kind)
        if vpPlace == "Left"
            f_drawProfile(dev, f_x(dev.startBar), math.max(f_x(dev.startBar) + 1, math.min(f_x(dev.startBar) + hw, bar_index)), false)
        else
            f_drawProfile(dev, bar_index + 2, bar_index + 2 + hw, false)
    for s in sessions
        sc = sesIndivCol ? s.col : levelCol
        farS = isFocus and math.abs(s.hi - close) > 3 * atr
        farL = isFocus and math.abs(s.lo - close) > 3 * atr
        if not s.hiTaken and not na(s.hiLn)
            line.set_x2(s.hiLn, bar_index + 5)
            line.set_color(s.hiLn, color.new(sc, farS ? 100 : f_alpha("untaken")))
        if not s.loTaken and not na(s.loLn)
            line.set_x2(s.loLn, bar_index + 5)
            line.set_color(s.loLn, color.new(sc, farL ? 100 : f_alpha("untaken")))
        if s.active
            if not na(s.dHiLn)
                line.set_x2(s.dHiLn, bar_index + 5)
            if not na(s.dLoLn)
                line.set_x2(s.dLoLn, bar_index + 5)
        if useSesLabels and s.show and s.done
            if not s.hiTaken and not farS
                f_edgePush(s.hi, s.isPd ? "PDH" : s.abbr + " H", color.new(sc, f_alpha("untaken")), s.isPd ? 5 : 3)
            if not s.loTaken and not farL
                f_edgePush(s.lo, s.isPd ? "PDL" : s.abbr + " L", color.new(sc, f_alpha("untaken")), s.isPd ? 5 : 3)
    if useHtf and isLtf and htfPlace == "Right Side"
        f_placeRight(htf1)
        f_placeRight(htf2)
        f_placeRight(htf3)
        f_placeRight(htf4)
        f_placeRight(htf5)
        f_placeRight(htf6)
    if useFvg
        f_gapVis(fvgs, htf1, promote and isLtf and f_ladderSlot(htfTf1, htfOn1), true, nearAtr)
        f_gapVis(htf1, htf2, promote and isLtf and f_ladderSlot(htfTf1, htfOn1) and f_ladderSlot(htfTf2, htfOn2), f_slotLtf(htfTf1), nearAtr * 3)
        f_gapVis(htf2, htf3, promote and isLtf and f_ladderSlot(htfTf2, htfOn2) and f_ladderSlot(htfTf3, htfOn3), f_slotLtf(htfTf2), nearAtr * 3)
        f_gapVis(htf3, htf4, promote and f_anySlot(htfTf3, htfOn3) and f_anySlot(htfTf4, htfOn4), f_slotLtf(htfTf3), nearAtr * 3)
        f_gapVis(htf4, htf5, promote and f_anySlot(htfTf4, htfOn4) and f_anySlot(htfTf5, htfOn5), f_slotLtf(htfTf4), nearAtr * 3)
        f_gapVis(htf5, htf6, promote and f_anySlot(htfTf5, htfOn5) and f_anySlot(htfTf6, htfOn6), f_slotLtf(htfTf5), nearAtr * 3)
        f_gapVis(htf6, htf5, false, f_slotLtf(htfTf6), nearAtr * 3)
    // EQ clusters and the CISD level (while the shift is still awaited)
    for ln in eqLines
        line.delete(ln)
    array.clear(eqLines)
    line.delete(cisdLn)
    if not isLean
        eqDrawn = array.new<float>()
        for p in pivs
            if p.eq and p.eqN >= 2 and array.size(eqLines) < 6 and array.indexof(eqDrawn, p.eqLvl) < 0 and math.abs(p.eqLvl - close) <= 6 * atr
                array.push(eqDrawn, p.eqLvl)
                array.push(eqLines, line.new(f_x(p.bar), p.eqLvl, bar_index + 5, p.eqLvl, color = color.new(levelCol, 45), style = line.style_dotted))
                f_edgePush(p.eqLvl, p.isHigh ? "EQH" : "EQL", color.new(levelCol, 45), 3)
    if (st.swDir == 1 or st.swDir == -1) and not st.mssOK and not na(st.cisdLvl)
        cc = st.swDir == 1 ? bullCol : bearCol
        cisdLn := line.new(f_x(st.cisdBar), st.cisdLvl, bar_index + 5, st.cisdLvl, color = color.new(cc, 40), style = line.style_dotted)
        f_edgePush(st.cisdLvl, "CISD", color.new(cc, 40), 2)
    f_planLabels()
    f_edgeFlush()

// ───────────────────────────── Macro window (:50 → :10 New York) ─────────────────────────────
f_macroText() =>
    t = barstate.isrealtime ? timenow : time
    m = minute(t, TZ)
    s = second(t, TZ)
    secIn = m * 60 + s
    suffix = barstate.isrealtime ? "" : " · Bar time"
    txt = m >= 50 ? "Ends in " + f_mmss(70 * 60 - secIn) + suffix : m < 10 ? "Ends in " + f_mmss(10 * 60 - secIn) + suffix : "Starts in " + f_mmss(50 * 60 - secIn) + suffix
    txt

// ───────────────────────────── Checklist text (last bar only) ─────────────────────────────
f_check(bool b) =>
    b ? "✓" : "☐"

// Liquidity left (untaken sides of tracked levels)
f_liqLeft() =>
    s = ""
    for ses in sessions
        if ses.done
            part = ses.abbr == "PD" ? (not ses.hiTaken and not ses.loTaken ? "PDH/PDL" : not ses.hiTaken ? "PDH" : not ses.loTaken ? "PDL" : "") : (not ses.hiTaken and not ses.loTaken ? ses.abbr + " H/L" : not ses.hiTaken ? ses.abbr + " H" : not ses.loTaken ? ses.abbr + " L" : "")
            if part != ""
                s := s == "" ? part : s + " • " + part
    s == "" ? "none" : s

planLive    = st.plState == 1 or st.plState == 2
planDone    = st.plState == 3 or st.plState == 4 or st.plState == 5
resultFresh = planDone and bar_index - st.plEndBar <= resultBars
noteFresh   = st.lastNote != "" and bar_index - st.lastNoteBar <= 5
sweepLive   = st.swDir == 1 or st.swDir == -1

// ───────────────────────────── Tables ─────────────────────────────
var table cl  = table.new(clPos, 2, 24, bgcolor = color.new(chart.bg_color, 10), border_width = 0, frame_color = color.new(chart.fg_color, 80), frame_width = 1)
var table lq  = table.new(liqPos, 3, 9, bgcolor = color.new(chart.bg_color, 10), border_width = 0, frame_color = color.new(chart.fg_color, 80), frame_width = 1)

txtCol  = chart.fg_color
dimCol  = color.new(chart.fg_color, 45)
headBg  = color.new(chart.fg_color, 90)
okCol   = bullCol
warnCol = #bf9000

f_row(int r, string k, string v, color vc) =>
    table.cell(cl, 0, r, k, text_color = dimCol, text_size = panelSize, text_halign = text.align_left)
    table.cell(cl, 1, r, v, text_color = vc, text_size = panelSize, text_halign = text.align_left)

if barstate.islast
    table.clear(cl, 0, 0, 1, 23)
    table.clear(lq, 0, 0, 2, 8)
    if useChecklist
        dirTxt = planLive ? (st.plDir == 1 ? "Bull" : "Bear") : st.swDir == 2 ? "Review" : dirNow == 1 ? "Bull" : dirNow == -1 ? "Bear" : "Neutral"
        dirColor = dirTxt == "Bull" ? bullCol : dirTxt == "Bear" ? bearCol : txtCol
        scoreOn = gradeMode == "Confluence score"
        [liveScore, livePts] = f_score(dirNow == 0 ? 1 : dirNow, "", close, float(na), float(na), Fvg(na))
        scoreTag = scoreOn ? (planLive or resultFresh ? " · " + str.tostring(st.plScore) + "/11" : dirNow != 0 ? " · " + str.tostring(liveScore) + "/11" : "") : ""
        gradeTxt = (st.plState == 2 ? "Grade " + st.plGrade : st.plState == 1 ? "Grade " + st.plGrade + " · Pending" : resultFresh ? "Grade " + st.plGrade + (st.plState == 3 ? " · Done" : st.plState == 4 ? " · Invalid" : " · Expired") : "Ungraded") + scoreTag
        headerTip = scoreOn ? (planLive or resultFresh ? "Saved idea · " + st.plPts : dirNow != 0 ? "Live context · " + livePts : "No direction yet") : "G2S grading · A = sweep + reaction + VP alignment · A+ = A plus two confluences"
        headerTxt = "G2S · " + dirTxt + (dayBias != 0 ? (dayBias == 1 ? " ↑" : " ↓") : "") + " · " + gradeTxt + (isOrig ? " · Original" : isStrict ? " · Strict" : " · Custom")
        setupTxt = planLive or resultFresh ? st.plFamily : st.vpDir != 0 and st.vpDir == dirNow ? (st.vpKind == "Rotation" ? "Value Rotation" : "Value Continuation") : sweepLive ? "Liquidity Inversion" : "—"
        modelTxt = st.plState == 2 ? st.plModel + " ✓ · " + st.plLed : st.plState == 1 ? st.plModel + " · Pending · " + st.plLed : resultFresh ? st.plModel + " · " + st.lastResult : st.reactOK and st.reactDir == dirNow ? (sweepLive ? "FVG / IFVG" : "FVG Retest") + " · Pending · Price-action-led" : st.vpDir != 0 and st.vpDir == dirNow and st.vpKind == "Rotation" ? "VP Retest / Hold · Pending · VP-led" : "FVG / IFVG · Pending · Price-action-led"
        sweepTxt = st.swDir == 2 ? "Two-sided · Review" : sweepLive ? (st.swDir == 1 ? "Bull" : "Bear") + " sweep · " + st.swName : "No qualifying sweep"
        reactShown = st.reactOK and st.reactDir == (planLive ? st.plDir : dirNow)
        reactTxt = reactShown ? st.reactType + " ✓" + (needMss and not planLive ? (st.mssOK ? " · " + (st.mssVia == "" ? "Shift" : st.mssVia) + " ✓" : " · Shift ☐") : "") : "Not confirmed"
        dayTxt = not inRth ? "Outside cash hours" : not ibDone ? "IB forming" : (st.trendDir != 0 ? "Trend " + (st.trendDir == 1 ? "↑" : "↓") : ibBoth ? "Neutral · both IB sides" : "Balance") + " · IB " + (extUp >= extDn ? "+" + str.tostring(extUp, "#.#") : "−" + str.tostring(extDn, "#.#")) + "× · VWAP " + str.tostring(math.round(vwPct * 100)) + " % " + (vwSide == 1 ? "above" : vwSide == -1 ? "below" : "–")
        htfAlignedTf = dirNow != 0 ? f_htfAligned(dirNow) : ""
        htfTxt = htfAlignedTf != "" ? htfAlignedTf + " FVG ✓" : "Not recorded"
        smtTxt = smtFresh ? (st.smtDir == 1 ? "Bullish ✓ · " : "Bearish ✓ · ") + st.smtWho : "Not recorded"
        vpTxt = (not useVp ? "Off" : planLive ? st.plVpBasis : st.vpDir != 0 ? st.vpRole + " " + st.vpLevel + " · " + (dirNow == st.vpDir ? "Same direction" : "Opposite direction") : vpLocation) + (useVp and not na(dev) and not devEligible ? " · DEV " + str.tostring(dev.bars) + "/" + str.tostring(f_devNeed()) : "")
        statusTxt = st.plState == 2 ? (st.plHit > 0 ? "TP" + str.tostring(st.plHit) + " ✓" : "ACTIVE") + (st.plDir == 1 ? " · LONG" : " · SHORT") : st.plState == 1 ? "Waiting for " + (st.plModel == "IFVG Close" ? "IFVG retest" : st.plModel + " entry") + " · " + f_price(st.plEntry) : resultFresh ? st.lastResult : noteFresh ? st.lastNote : st.swDir == 2 ? "Review · two-sided sweep" : sweepLive and not st.reactOK ? "Waiting for reaction" : sweepLive and st.reactOK ? "Waiting for FVG / IFVG entry" : st.vpDir != 0 and st.vpKind == "Rotation" ? "Waiting for VP retest/hold" : st.vpDir != 0 ? "Waiting for FVG retest" : "Scanning"
        macroTxt = f_macroText()
        macroOn  = str.startswith(macroTxt, "Ends")
        macroCol = macroOn ? okCol : dimCol
        macroBg  = macroOn ? color.new(okCol, 85) : color.new(color.white, 100)
        confOK = planLive or (resultFresh and st.plState == 3) or st.reactOK or st.vpModel != ""
        decided = st.nWin + st.nLoss
        shDecided = sh.nWin + sh.nLoss
        shadowTxt = "Filtered · " + str.tostring(sh.nPlans) + " · win " + (shDecided > 0 ? str.tostring(math.round(100.0 * sh.nWin / shDecided)) + "%" : "–") + " · TP3 " + (shDecided > 0 ? str.tostring(math.round(100.0 * sh.nFull / shDecided)) + "%" : "–") + " · stops " + str.tostring(sh.nLoss) + " · exp " + str.tostring(sh.nExp)
        statsTxt = (shadowMode != "Off" ? "Saved · " : "") + str.tostring(st.nPlans) + " ideas · win " + (decided > 0 ? str.tostring(math.round(100.0 * st.nWin / decided)) + "%" : "–") + " (TP1) · TP3 " + (decided > 0 ? str.tostring(math.round(100.0 * st.nFull / decided)) + "%" : "–") + " · stops " + str.tostring(st.nLoss) + " · exp " + str.tostring(st.nExp) + " · ctrl " + (st.nCtrlWin + st.nCtrlLoss > 0 ? str.tostring(math.round(100.0 * st.nCtrlWin / (st.nCtrlWin + st.nCtrlLoss))) + "%" : "–")
        swCol = sweepLive ? okCol : st.swDir == 2 ? warnCol : dimCol
        modelCol = st.plState == 2 ? okCol : warnCol
        statusCol = st.plState == 2 ? okCol : st.plState == 4 and resultFresh ? bearCol : st.plState == 1 or str.startswith(statusTxt, "Waiting") ? warnCol : txtCol
        table.cell(cl, 0, 0, headerTxt, text_color = dirColor, bgcolor = headBg, text_size = panelSize, text_halign = text.align_left, tooltip = headerTip)
        table.cell(cl, 1, 0, "", bgcolor = headBg)
        table.merge_cells(cl, 0, 0, 1, 0)
        macroRow = 0
        if clLayout == "Minimal" or isMinLay
            f_row(1, "Entry Model", modelTxt, modelCol)
            f_row(2, "Status", statusTxt, statusCol)
            f_row(3, "Macro Window", macroTxt, macroCol)
            macroRow := 3
        else
            r = 1
            if clLayout == "Full"
                f_row(r, "1 · Liquidity sweep?", f_check(st.swDir == 1 or st.swDir == -1) + " " + sweepTxt, swCol)
                f_row(r + 1, "2 · HTF FVG? (opt.)", f_check(htfTxt != "Not recorded") + " " + htfTxt, txtCol)
                f_row(r + 2, "3 · SMT? (opt.)", f_check(smtFresh) + " " + smtTxt, txtCol)
                f_row(r + 3, "4 · Displacement / reversal?", f_check(reactShown) + " " + reactTxt, reactShown ? okCol : dimCol)
                f_row(r + 4, "5 · Confirmed FVG / IFVG / VP entry?", f_check(st.plState == 2) + " " + modelTxt, modelCol)
                f_row(r + 5, "6 · Entry / SL / targets", planLive or (resultFresh and st.plState == 3) ? "E " + f_price(st.plEntry) + " · SL " + f_price(st.plSl) : "☐ Waiting", txtCol)
                r := r + 6
            f_row(r, "Setup Type", setupTxt, txtCol)
            f_row(r + 1, "Entry Model", modelTxt, modelCol)
            f_row(r + 2, "Liquidity Sweep", sweepTxt, swCol)
            f_row(r + 3, "Price Reaction", reactTxt, reactShown ? okCol : dimCol)
            f_row(r + 4, "HTF FVG (opt.)", htfTxt, htfTxt != "Not recorded" ? okCol : dimCol)
            f_row(r + 5, "SMT (opt.)", smtTxt, smtFresh ? okCol : dimCol)
            f_row(r + 6, "VP Context", vpTxt, planLive and st.plLed == "VP-led" ? okCol : dimCol)
            f_row(r + 7, "Day", dayTxt, st.trendDir != 0 ? warnCol : dimCol)
            f_row(r + 8, "Liq left", f_liqLeft(), dimCol)
            f_row(r + 9, "Status", statusTxt, statusCol)
            f_row(r + 10, "Macro Window", macroTxt, macroCol)
            macroRow := r + 10
            nextRow = r + 11
            if clLayout == "Full" and (planLive or (resultFresh and st.plState == 3))
                for [i, tp] in st.plTps
                    f_row(nextRow, "TP" + str.tostring(i + 1) + (i < st.plHit ? " ✓" : ""), f_price(tp) + " · " + str.tostring(math.abs(tp - st.plEntry) / st.plR, "#.##") + "R", txtCol)
                    nextRow += 1
            if showStats
                table.cell(cl, 0, nextRow, statsTxt, text_color = dimCol, text_size = panelSize, text_halign = text.align_left)
                table.cell(cl, 1, nextRow, "", text_size = panelSize)
                table.merge_cells(cl, 0, nextRow, 1, nextRow)
                if shadowMode != "Off"
                    table.cell(cl, 0, nextRow + 1, shadowTxt, text_color = dimCol, text_size = panelSize, text_halign = text.align_left)
                    table.cell(cl, 1, nextRow + 1, "", text_size = panelSize)
                    table.merge_cells(cl, 0, nextRow + 1, 1, nextRow + 1)
        if macroRow > 0
            table.cell_set_bgcolor(cl, 0, macroRow, macroBg)
            table.cell_set_bgcolor(cl, 1, macroRow, macroBg)
    if useLiqPanel
        table.cell(lq, 0, 0, "G2S Liquidity", text_color = txtCol, bgcolor = headBg, text_size = panelSize, text_halign = text.align_left)
        table.cell(lq, 1, 0, "", bgcolor = headBg)
        table.cell(lq, 2, 0, "", bgcolor = headBg)
        table.merge_cells(lq, 0, 0, 2, 0)
        table.cell(lq, 0, 1, "Range", text_color = dimCol, text_size = panelSize, text_halign = text.align_left)
        table.cell(lq, 1, 1, "High", text_color = dimCol, text_size = panelSize)
        table.cell(lq, 2, 1, "Low", text_color = dimCol, text_size = panelSize)
        for [i, s] in sessions
            hiTxt = not s.done ? "?" : f_check(s.hiTaken)
            loTxt = not s.done ? "?" : f_check(s.loTaken)
            hiTip = na(s.hi) ? "No completed instance yet" : s.name + " High " + f_price(s.hi) + (s.hiTaken ? " · taken " + str.format_time(s.hiTakenTime, "HH:mm", TZ) : " · untaken")
            loTip = na(s.lo) ? "No completed instance yet" : s.name + " Low " + f_price(s.lo) + (s.loTaken ? " · taken " + str.format_time(s.loTakenTime, "HH:mm", TZ) : " · untaken")
            table.cell(lq, 0, 2 + i, s.name, text_color = txtCol, text_size = panelSize, text_halign = text.align_left)
            table.cell(lq, 1, 2 + i, hiTxt, text_color = s.hiTaken ? okCol : txtCol, text_size = panelSize, tooltip = hiTip)
            table.cell(lq, 2, 2 + i, loTxt, text_color = s.loTaken ? okCol : txtCol, text_size = panelSize, tooltip = loTip)

// ───────────────────────────── Alerts ─────────────────────────────
if newPlan
    tpTxt = ""
    for [i, tp] in st.plTps
        tpTxt := tpTxt + " · TP" + str.tostring(i + 1) + " " + f_price(tp)
    alert("NEW IDEA · G2S " + (st.plDir == 1 ? "Bull · LONG" : "Bear · SHORT") + " · Grade " + st.plGrade + " · " + st.plFamily + " · " + st.plModel + " (" + st.plLed + ") · " + syminfo.ticker + " " + chartTfLabel + " · Entry " + f_price(st.plEntry) + " · SL " + f_price(st.plSl) + tpTxt + " · " + (st.plState == 2 ? "ACTIVE" : "Pending"), alert.freq_once_per_bar_close)


// ───────────────────────────── Backtest orders (strategy build only) ─────────────────────────────
// Enters at the close of the bar on which a plan becomes ACTIVE, scales out at TP1 / TP2 / TP3 with the
// shared stop, optionally moves the stop to breakeven after TP1, and flattens when the plan ends.
const string GBT = "⑩ Backtest"
btBreakeven = input.bool(true, "Move stop to breakeven after TP1", group = GBT)
btSplit     = input.bool(true, "Scale out one third at each target", group = GBT)
var int btPlanBar = na
if confirmed
    if st.plState == 2 and strategy.position_size == 0 and (na(btPlanBar) or btPlanBar != st.plBar)
        btPlanBar := st.plBar
        strategy.entry("G2S", st.plDir == 1 ? strategy.long : strategy.short, comment = st.plGrade + " " + st.plModel)
    if st.plState == 2 and btPlanBar == st.plBar
        slNow = btBreakeven and st.plHit >= 1 ? st.plEntry : st.plSl
        nT = array.size(st.plTps)
        if btSplit and nT >= 2
            strategy.exit("TP1", "G2S", limit = array.get(st.plTps, 0), stop = slNow, qty_percent = nT == 3 ? 34 : 50)
            strategy.exit("TP2", "G2S", limit = array.get(st.plTps, 1), stop = slNow, qty_percent = nT == 3 ? 33 : 50)
            if nT == 3
                strategy.exit("TP3", "G2S", limit = array.get(st.plTps, 2), stop = slNow, qty_percent = 33)
        else
            strategy.exit("TP", "G2S", limit = array.get(st.plTps, nT - 1), stop = slNow)
    if strategy.position_size != 0 and st.plState != 2
        strategy.close("G2S", comment = "plan ended")
